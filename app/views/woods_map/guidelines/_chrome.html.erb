<%# C5 · Chrome: the page frame, controls, chips, tooltip, four widths. %>
<% sample = { 'generation' => 42, 'git_sha' => '361468d9f8e7', 'git_branch' => 'main', 'extracted_at' => '2026-10-16T12:10:00Z' }
   nav = [['Units', '#', true], ['Landscape', '#', false], ['Graph', '#', false], ['ERD', '#', false], ['Impact', '#', false], ['History', '#', false]]
   tabs = [{ label: 'Code', count: '64 lines', href: '#' }, { label: 'Schema', count: 14, href: '#' }, { label: 'Lifecycle', count: 6, href: '#', current: true }, { label: 'Graph', count: 18, href: '#' }, { label: 'History', count: 23, href: '#' }]
   controls = safe_join([tag.span('entry', class: 'lbl'), tag.span(safe_join([tag.button('create', type: 'button', 'aria-pressed': 'true'), tag.button('update', type: 'button'), tag.button('destroy', type: 'button')]), class: 'seg'), tag.span('view', class: 'lbl'), tag.span(safe_join([tag.button('sequence', type: 'button', 'aria-pressed': 'true'), tag.button('flowchart', type: 'button'), tag.button('lanes', type: 'button')]), class: 'seg'), tag.button('Share ▾', class: 'btn', type: 'button'), tag.button('Code at L18', class: 'btn primary', type: 'button')], ' ')
   tiles = [
     { eyebrow: 'Table', rows: [['name', link_to('posts', '#')], ['columns', '14, 3 indexes'], ['FK', 'author_id → users'], ['source', layer_chip('model metadata')]] },
     { eyebrow: 'Used by 12', rows: [['controllers', safe_join([link_to('PostsController', '#'), ', ', link_to('Api::PostsController', '#')])], ['views', safe_join([link_to('posts/show', '#'), ', ', link_to('posts/_card', '#'), ' ', tag.button('+7 more', class: 'tool', type: 'button', 'aria-expanded': 'false')])], ['other', safe_join([link_to('PostSerializer', '#'), ', ', link_to('PublishPostJob', '#')])]] },
     { eyebrow: 'Depends on 6', rows: [['belongs_to', link_to('User', '#')], ['has_many', link_to('Comment', '#')], ['through', safe_join([link_to('Tag', '#'), ' via taggings'])], ['include', safe_join([link_to('Taggable', '#'), ', ', link_to('Countable', '#')])], ['enqueue', link_to('NotifySubscribersJob', '#')]] },
     { eyebrow: 'History', rows: [['last', safe_join(['Leah, ', date_abbr('2026-10-13T14:02:00Z', now: Time.utc(2026, 10, 16, 14, 2))])], ['churn', safe_join(['23 commits / yr ', chip(:hot)])], ['people', '3 in 365d'], ['more', safe_join([link_to('diff vs gen 41', '#'), ', ', link_to('timeline', '#')])]] }
   ]
   status_items = ['sequence', 'numbers match the steps', 'scroll sideways on narrow screens']
   keys = [[%w[c u d], 'event'], [%w[s f l], 'view'], [%w[y], 'copy'], [%w[?], 'all']] %>
<section class="sec" id="chrome"><header><h2 class="t2">C5 · Chrome</h2><span class="n">top bar, breadcrumb band, title block, tabs, facts tiles, status bar, buttons, chips, tooltip</span></header>
  <h3 class="t3 h-first" id="chrome-frame">Page frame</h3>
  <div class="wm narrow">
    <%= render 'woods_map/shared/bar', generation: sample, nav: nav, search_path: '#', label: 'Primary, frame at full width' %>
    <%= render 'woods_map/shared/crumbs', crumbs: [['units', '#'], ['models', '#'], ['Post', nil]], path: 'app/models/post.rb', trail: safe_join(['trail: ', link_to('posts/show', '#'), ' ‹ ', link_to('PostsController', '#'), ' ‹ Post']) %>
    <%= render 'woods_map/shared/ident', title: 'Post', subtitle: 'model, table posts', controls: controls, level: :div %>
    <%= render 'woods_map/shared/tabs', tabs: tabs, label: 'Sections, frame at full width' %>
    <div class="inset5"><%= render 'woods_map/components/facts', tiles: tiles %></div>
    <%= render 'woods_map/shared/status', items: status_items, keys: keys %>
  </div>
  <div class="spec-note"><b>top bar</b> 52px panel; wordmark, search (340px, ground2, kbd hint), section nav in Inter 500, freshness as ● + words, gen number, SHA. <b>breadcrumb band</b> its own 32px strip on ground2 fused to the top bar: crumbs, path with ⎘, trail on the right. <b>h1</b> 24px Inter 700 snow; the subtitle is only what the unit is. <b>actions</b> every control in a toolbar is 30px tall: segmented controls, one default button, one primary; right-aligned, 8px gaps. <b>tabs</b> 36px, 2px purple+ underline on the selected tab, one count per tab. <b>facts</b> four tiles on panel; an eyebrow with a rule, then label / value rows. <b>status</b> 32px panel, provenance left, keys right with kbd chips.</div>
  <h3 class="t3 h-next" id="chrome-controls">Controls, chips, tooltip</h3>
  <div class="row">
    <div class="box"><div class="lbl">buttons and tools</div><div class="ctl-row wide"><button class="btn primary" type="button">Open in editor</button><button class="btn" type="button">Share ▾</button><button class="btn dimmed" type="button" disabled>Export</button><button class="tool" type="button">⎘ copy Mermaid</button><button class="tool" type="button">expand all</button><span class="seg"><button type="button" aria-pressed="true">keys</button><button type="button">all</button></span></div><div class="spec-note"><b>primary</b> purple+ fill, one per page. <b>default</b> ground2 with a rule2 border, purple+ border on hover. <b>tool</b> slate text with a rule2 underline, purple+ on hover; glyph before the word. <b>disabled</b> 50% opacity, never a different colour.</div></div>
    <div class="box"><div class="lbl">links and chips</div><div class="lead loose"><%= link_to('PostsController#create', '#') %> <span class="mut">a link, cobalt+, underline on hover</span><br><%= chip(:modified) %> modified in this generation <%= chip(:hot) %> 23 commits / yr <%= chip(:risk) %> risk <%= chip(:blocking) %> <%= chip(:note) %> <%= chip(:fresh) %><br><%= layer_chip('typed edges') %> <%= layer_chip('W-20') %> <span class="mut">layer chips: provenance, never meaning</span><br><abbr title="generation">gen</abbr> 42 <span class="mut">shorthand with a dotted underline</span></div></div>
    <div class="box"><div class="lbl">tooltip and ⓘ (hover or focus)</div><h2 class="t2">Steps for create <%= count_tag('12 steps') %><%= info_tip('Order is the resolved runtime chain, not file order. Side effects come from a regex analysis of the callback body.', html: 'Order is the resolved runtime chain, not file order. Side effects come from a regex analysis of the callback body. <a href="https://github.com/lost-in-the/woods#readme">How Woods resolves callbacks ↗</a>') %></h2><div class="gap-top"><%= date_abbr('2026-10-13T14:02:00Z', now: Time.utc(2026, 10, 16, 14, 2)) %> <span class="mut">an abbr: the long form on hover</span> · <%= who('Sam Okafor-Whitfield', email: 'sam@example.com') %> <span class="mut">a truncated author</span></div><div class="spec-note">12px Inter on panel, rule2 border, a caret pointing at its anchor, below and left-aligned (above when there is no room), 300ms delay, on focus too; Escape closes. A tooltip may hold a link, so it stays open while hovered or focused and is reachable with Tab. ⓘ is a suffix on the header, slate, and explains; it never holds anything needed to act.</div></div>
  </div>
  <h3 class="t3 h-next" id="chrome-widths">Four widths</h3>
  <div class="row phone">
    <div class="box"><div class="lbl">split, 960: search shrinks, nav keeps its words</div><div class="wm narrow w960"><%= render 'woods_map/shared/bar', generation: sample, nav: nav, search_path: '#', label: 'Primary, frame at 960' %><%= render 'woods_map/shared/crumbs', crumbs: [['units', '#'], ['models', '#'], ['Post', nil]], path: 'app/models/post.rb' %><%= render 'woods_map/shared/ident', title: 'Post', subtitle: 'model, table posts', controls: controls, level: :div %><%= render 'woods_map/shared/tabs', tabs: tabs, label: 'Sections, frame at 960' %><div class="spacer5"></div></div>
      <div class="lbl gap-top5">narrow, 640: ☰ top-left holds files, sections and the site nav; actions wrap under the title; tiles 2-up</div><div class="wm narrow w640"><%= render 'woods_map/shared/bar', generation: sample, nav: nav, search_path: '#', label: 'Primary, frame at 640' %><%= render 'woods_map/shared/crumbs', crumbs: [['units', '#'], ['models', '#'], ['Post', nil]], path: 'app/models/post.rb' %><%= render 'woods_map/shared/ident', title: 'Post', subtitle: 'model, table posts', controls: controls, level: :div %><div class="inset5"><%= render 'woods_map/components/facts', tiles: tiles %></div></div></div>
    <div class="box"><div class="lbl">phone, 390: ☰ opens files and sections; tiles as rows; tabs scroll with a cliff</div><div class="wm narrow w390"><%= render 'woods_map/shared/bar', generation: sample, nav: nav, search_path: '#', label: 'Primary, frame at 390' %><%= render 'woods_map/shared/crumbs', crumbs: [['units', '#'], ['models', '#'], ['Post', nil]], path: 'app/models/post.rb' %><%= render 'woods_map/shared/ident', title: 'Post', subtitle: 'model, table posts', level: :div %><div class="hscroll" data-controller="cliff"><%= render 'woods_map/shared/tabs', tabs: tabs, label: 'Sections, frame at 390' %></div><div class="inset4"><%= render 'woods_map/components/facts', tiles: tiles.first(2) %></div><%= render 'woods_map/shared/status', items: ['sequence', 'gen 42'] %></div></div>
  </div>
</section>
