<%# A diagram panel (C4-Diagrams): header band, body that scrolls sideways,
    legend under a rule. Locals: title (String), facts (Array of String),
    tools (HTML or nil), legend (Array of [mark, text] or nil),
    provenance (Array of String or nil), and either body (HTML) or
    mermaid (String) with label (String, the diagram's accessible name).
    Mermaid text is drawn by Pele in the browser (D-21) and stays in the
    page as the no-JavaScript fallback and the copy source; refusal (String
    or nil) keeps the text and says why nothing is drawn, such as a node
    budget (R-4). A Mermaid panel carries its own copy tool and .mmd link
    (components/mermaid_tools); name (String) names the file, the title by
    default; mermaid_url (String) is the panel's .mmd route (D-25); key ("y" or nil) marks
    the copy the status bar names; and
    export: false leaves the tools out. Refused text larger than
    MermaidExport::INLINE_BYTES is not carried, and the panel says so. %>
<% mermaid = local_assigns[:mermaid] %>
<% refusal = local_assigns[:refusal] %>
<% drawn = mermaid && !refusal %>
<% export = mermaid && local_assigns.fetch(:export, true) %>
<div class="dia"<% if drawn %> data-controller="diagram" data-diagram-label-value="<%= local_assigns[:label] || title %>"<% end %>>
  <div class="dh"><b><%= title %></b><% facts.each do |fact| %><span><%= fact %></span><% end %><% if local_assigns[:tools] || drawn || export %><span class="tools"><%= local_assigns[:tools] %><% if export %><%= render 'woods_map/components/mermaid_tools', text: mermaid, name: local_assigns[:name] || title, url: local_assigns[:mermaid_url], key: local_assigns[:key], refused: refusal.present? %><% end %><% if drawn %><button class="tool" type="button" hidden data-diagram-target="toggle" data-action="diagram#toggle" aria-pressed="false">Mermaid text</button><% end %></span><% end %></div>
  <% if mermaid %>
    <div class="dw hscroll" data-controller="cliff" data-diagram-target="scroller">
      <% if refusal %><p class="cap refusal"><%= refusal %></p><% else %><p class="cap refusal" role="status" data-diagram-target="message" hidden></p><% end %>
      <div class="pele-host" data-diagram-target="canvas" hidden></div>
      <% if refusal && WoodsMap::MermaidExport.oversized?(mermaid) %>
        <p class="cap">Its Mermaid text, <%= number_to_human_size(mermaid.bytesize) %>, is not carried in this page.</p>
      <% else %>
        <pre class="cmd bare" role="region" aria-label="Mermaid source" tabindex="0" data-controller="cliff" data-diagram-target="source"><%= mermaid %></pre>
      <% end %>
    </div>
  <% else %>
    <div class="dw hscroll" data-controller="cliff"><%= body %></div>
  <% end %>
  <% if local_assigns[:legend] %><%= render 'woods_map/components/legend', entries: legend, provenance: local_assigns[:provenance] %><% end %>
</div>
