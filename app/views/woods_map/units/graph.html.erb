<% content_for :title, "#{@page.identifier} · Graph · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% n = @neighbourhood %>
<%= render 'woods_map/units/frame', page: @page, tab: 'graph', definition: @definition %>
<%= render 'woods_map/graphs/explorer', identifier: @page.identifier, type: @page.type, n: n,
      link: ->(**opts) { woods_map.unit_graph_path(type: @page.type, identifier: @page.identifier, **opts.except(:blast).compact) },
      unit_url: woods_map.unit_graph_path(type: '__type__', identifier: '__identifier__', depth: n.depth, direction: n.direction),
      rail_extra: tag.div('full screen', class: 'grp') + tag.ol(tag.li(safe_join([tag.span('·', class: 'k'), tag.span(safe_join([link_to('full-screen graph', woods_map.graph_path(centre: @page.identifier, type: @page.type, depth: n.depth, direction: n.direction)), ' ', tag.span('blast radius tint, more room', class: 'own')]))]))) %>
