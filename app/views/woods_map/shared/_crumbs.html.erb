<%# The breadcrumb band under the bar (D-18): ☰ files, crumbs, the path with
    ⎘ copy, the reading trail on the right. Locals: crumbs (Array of [label, href]
    with the last one current), path (String or nil), trail (HTML or nil). %>
<div class="crumbs">
  <button class="tool files" type="button" aria-label="Open files" data-action="sheet#open" data-needs-js><span aria-hidden="true">☰</span> files</button>
  <span><% crumbs.each_with_index do |(label, href), index| %><% if index.positive? %> › <% end %><% if href %><a href="<%= href %>"><%= label %></a><% else %><span class="bright"><%= label %></span><% end %><% end %></span>
  <% if local_assigns[:path] %><span class="path"><%= path %> <button class="tool" type="button" aria-label="Copy path" data-controller="copy" data-copy-text-value="<%= path %>" data-action="copy#copy" data-needs-js>⎘</button></span><% end %>
  <% if local_assigns[:trail] %><span class="path trail"><%= trail %></span><% end %>
</div>
