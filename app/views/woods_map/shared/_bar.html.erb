<%# The top bar (C5-Chrome): ☰ below 960, wordmark, search, primary nav,
    freshness as ● + words, generation, SHA. Locals: generation (Hash or nil),
    freshness (Hash or nil), nav (Array of [label, href, current?]),
    search_path (String or nil), query (String or nil), label (landmark name). %>
<% nav = local_assigns[:nav] || [['Units', woods_map.search_path, false], ['Impact', woods_map.impact_path, false]] %>
<% fresh_class, fresh_words = freshness_words(local_assigns[:freshness].to_h['state'].to_s) %>
<% fresh_detail = freshness_detail(local_assigns[:freshness]) %>
<header class="bar">
  <button class="tool menu-toggle" type="button" aria-label="Files and sections" aria-expanded="false" data-action="sheet#open" data-needs-js>☰</button>
  <a href="<%= woods_map.root_path %>" class="brand"><%= render 'woods_map/shared/mark' %>woods</a>
  <% if local_assigns.fetch(:search_path) { woods_map.search_path } %>
    <form class="bar-search" role="search" aria-label="<%= local_assigns.fetch(:label, 'Primary') == 'Primary' ? 'Search' : "Search, #{local_assigns[:label]}" %>" action="<%= local_assigns.fetch(:search_path) { woods_map.search_path } %>" method="get" data-controller="palette" data-palette-url-value="<%= woods_map.palette_path %>" data-action="submit->palette#submit"><span aria-hidden="true">⌕</span><input class="q" type="search" name="q" placeholder="Search units, files, routes, tables, code" aria-label="Search units, files, routes, tables, code" value="<%= local_assigns[:query] %>" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="wm-palette" data-palette-target="input" data-action="input->palette#query focus->palette#open keydown->palette#key"><span class="kbd" aria-hidden="true">/</span><div class="palette-wrap" hidden data-palette-target="wrap" data-action="click->palette#outside"><div class="palette" id="wm-palette" role="listbox" aria-label="Search palette" data-palette-target="panel"></div></div></form>
  <% end %>
  <nav aria-label="<%= local_assigns.fetch(:label, 'Primary') %>"><% nav.each do |label, href, current| %><a href="<%= href %>"<%= ' aria-current="page"'.html_safe if current %>><%= label %></a><% end %></nav>
  <span class="bar-fresh">
    <% if generation %>
      <span class="why"<%= " title=\"#{ERB::Util.html_escape(fresh_detail)}\"".html_safe if fresh_detail %>><span class="<%= fresh_class %>">●</span><span class="w"> <%= fresh_words %></span></span>
      <span class="w">gen <b class="bright"><%= generation['generation'] %></b></span>
      <span class="w"><%= short_sha(generation['git_sha']) %></span>
    <% else %>
      <span><span class="dim">○</span><span class="w"> no index</span></span>
    <% end %>
  </span>
</header>
