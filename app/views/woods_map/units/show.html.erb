<% content_for :title, "#{@page.identifier} · Code · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% lens_controls = safe_join([tag.span('lens', class: 'lbl'), tag.span(safe_join([
     link_to('as written', woods_map.unit_path(type: @page.type, identifier: @page.identifier, lens: 'written'), 'aria-current': (@code.lens == 'written' ? 'true' : nil)),
     link_to('effective class', woods_map.unit_path(type: @page.type, identifier: @page.identifier, lens: 'effective'), 'aria-current': (@code.lens == 'effective' ? 'true' : nil))
   ]), class: 'seg', role: 'group', 'aria-label': 'lens')]) %>
<%= render 'woods_map/units/frame', page: @page, tab: 'code', controls: lens_controls, definition: @code.definition_line, editor: true, context: "gen #{@repository.generation_number} · #{@code.lens == 'effective' ? 'effective class' : 'as written'} lens" %>
<div class="body" data-controller="trail peek card disambiguation" data-trail-url-value="<%= trail_url %>" data-trail-title-value="<%= @page.identifier %>">
  <% groups = @outline.groups.map { |g| { label: g.label, count: g.count, items: g.items.map { |i| { key: i.key, text: i.text, own: i.own, href: i.href } } } } %>
  <% groups = [{ label: 'nothing to outline', count: '', items: [{ key: '·', text: 'the index records no members for this unit' }] }] if groups.empty? %>
  <%= render 'woods_map/components/rail', heading: 'Outline, as Rails runs it', groups: groups %>
  <div class="main">
    <%= render 'woods_map/units/code_view', code: @code, page: @page, heat: @heat, concern_paths: @concern_paths %>
    <%= render 'woods_map/units/disambiguation', ambiguities: @code.ambiguities %>
    <%= render 'woods_map/units/callers', callers: @callers, page: @page %>
    <% @cards.each do |card| %><template data-card-target="card" data-href="<%= woods_map.unit_path(type: card.type, identifier: card.identifier) %>"><%= render 'woods_map/units/card', card: card %></template><% end %>
    <%= render 'woods_map/units/settings', page: @page, lens: @code.lens %>
    <%= render 'woods_map/shared/status', items: ['links: published reference spans; dashed static, dotted ambiguous', "heat strip: #{@page.unit.dig('metadata', 'git', 'change_frequency') || 'unknown'} churn, per unit until W-3", "gen #{@repository.generation_number}"], keys: [[%w[?], 'keyboard help'], [%w[p], 'peek'], [%w[/], 'search']] %>
  </div>
</div>
