<%# The export tools of a diagram (mermaid-diagram-types.md, constraint 3;
    D-25): ⎘ copies the Mermaid text already in the page, and ⤓ .mmd links
    to the same text served as text/plain from a stable URL, for people and
    for agents that should not scrape HTML. A type newer than GitHub's Mermaid
    says so. Locals: text (String, the Mermaid text), name (String, what the
    diagram shows, for the file name), url (String or nil, the .mmd route),
    key (String or nil: "y" when this is the copy the page's status bar names),
    refusal (String or nil: why the diagram is over its R-4 budget; its .mmd
    route answers 422 then, so the link is left out and the copy stays).
    data-mermaid-name and data-mermaid-href let the Share menu list the page's
    diagrams with their absolute .mmd URLs (D-25). %>
<% url = local_assigns[:refusal] ? nil : local_assigns[:url] %>
<%= tag.button('⎘ copy Mermaid', class: 'tool', type: 'button', data: { controller: 'copy', copy_text_value: text, action: 'copy#copy', needs_js: true, key: local_assigns[:key], mermaid_name: name, mermaid_href: (url && "#{request.base_url}#{url}") }.compact) %>
<% if url %><%= link_to('⤓ .mmd', url, class: 'tool', rel: 'alternate', type: 'text/plain', download: WoodsMap::MermaidExport.filename(name), data: { mermaid_url: true }) %><% elsif local_assigns[:refusal] && local_assigns[:url] %><span class="lyr" title="<%= local_assigns[:refusal] %>">no .mmd over the budget</span><% end %>
<% if WoodsMap::MermaidExport.newer_than_github?(text) %><span class="lyr">may not render on GitHub</span><% end %>
