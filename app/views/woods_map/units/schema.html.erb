<% content_for :title, "#{@page.identifier} · Schema · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<%= render 'woods_map/units/frame', page: @page, tab: 'schema', definition: @definition %>
<% assocs = @schema.associations %>
<% classes = @schema.class_diagram %>
<div class="body" data-controller="trail" data-trail-url-value="<%= trail_url %>" data-trail-title-value="<%= @page.identifier %>">
  <%= render 'woods_map/components/rail', heading: 'Schema, as the database has it', groups: [
        { label: 'table', count: @schema.table_name, items: [{ key: '·', text: "#{@schema.columns.size} #{'column'.pluralize(@schema.columns.size)}, #{@schema.indexes.size} #{'index'.pluralize(@schema.indexes.size)}" }] },
        { label: 'associations', count: assocs.size, items: assocs.each_with_index.map { |a, i| { key: i + 1, text: unit_link(a.target), own: a.macro } } }
      ].reject { |g| g[:items].empty? } %>
  <div class="main">
    <section class="sec" aria-label="Entity relationship">
      <%= render 'woods_map/components/diagram', title: 'Entity relationship', facts: [@schema.table_name, 'model associations only', pluralize(@schema.table_count, 'table')], name: "#{@page.identifier} schema", mermaid_url: woods_map.unit_schema_mmd_path(type: @page.type, identifier: @page.identifier), mermaid: @schema.mermaid, key: 'y', label: "Entity relationship diagram of #{@schema.table_name} and the tables one association away", refusal: (@schema.refusal && "#{@schema.refusal}; the associations below list every one."), legend: [['|', 'one'], ['○', 'zero or more'], ['crow\'s foot', 'many']], provenance: ['model metadata', "gen #{@repository.generation_number}"] %>
      <p class="cap">Drawn from this model's associations only. Foreign keys that no model association names are not drawn here; see the <%= link_to 'ERD', woods_map.erd_path %> for the database's own foreign keys.</p>
    </section>
    <section class="sec" aria-label="Class diagram">
      <%= render 'woods_map/components/diagram', title: 'Class diagram', facts: ["#{classes.class_count} classes", 'columns, scopes, own methods'], name: "#{@page.identifier} class diagram", mermaid_url: woods_map.unit_schema_mmd_path(type: @page.type, identifier: @page.identifier, view: 'class'), mermaid: classes.mermaid, label: "Class diagram of #{@page.identifier}: its columns, scopes and methods, its parent, the concerns it includes and the classes one association away", refusal: (classes.refusal && "#{classes.refusal}; the associations below list every one."), legend: [['<|--', 'inherits'], ['..|>', 'includes'], ['-->', 'association, with its multiplicity']], provenance: ['model metadata', "gen #{@repository.generation_number}"] %>
    </section>
    <section class="sec" aria-labelledby="assoc" data-controller="rows">
      <header><h2 class="t2" id="assoc">Associations <%= count_tag(assocs.size) %></h2></header>
      <%= render 'woods_map/components/table', label: 'Associations', min_width: '860px', columns: [{ label: 'macro', width: '200px', cell_class: 'nw id' }, { label: 'target', width: '140px' }, { label: 'options' }, { label: 'foreign key', width: '190px', cell_class: 'nw' }, { label: 'db enforced', width: '110px', cell_class: 'nw' }, { label: 'finding', width: '220px' }],
            rows: assocs.map { |a| { cells: [a.macro, unit_link(a.target), a.options.presence || empty_value(applicable: false), a.foreign_key || tag.span('derived', class: 'dim'), a.enforced, a.finding ? safe_join([chip(:note), ' ', a.finding]) : empty_value(applicable: false)] } } %>
    </section>
    <section class="sec" aria-labelledby="colsh">
      <% since_from = current_since&.available? ? current_since.from_generation : nil %>
      <% col_marks = since_from && (current_since.column_marks(@page.identifier, @page.type) || (@schema.table_name && current_since.column_marks("table:#{@schema.table_name}", 'database_table'))) %>
      <header><h2 class="t2" id="colsh">Columns <%= count_tag(@schema.columns.size) %></h2></header>
      <%= render 'woods_map/components/table', label: 'Columns', min_width: '760px', columns: [{ label: 'column', width: '180px', cell_class: 'nw id' }, { label: 'type', width: '110px' }, { label: 'null', width: '60px' }, { label: 'default', width: '110px' }, { label: 'index' }, { label: 'written by' }],
            caption: (col_marks&.removed&.any? ? "removed since gen #{since_from}: #{col_marks.removed.sort.join(', ')}" : nil),
            rows: @schema.columns.map { |c| kind = col_marks && col_marks[c.name]; { classes: (kind ? 'chg' : nil), cells: [(kind ? safe_join([chip(:modified, "#{kind} since gen #{since_from}"), tag.span(" #{kind} since gen #{since_from}: ", class: 'sr-only'), ' ', c.name]) : c.name), c.type, c.null, c.default.nil? ? empty_value(applicable: false) : c.default.to_s, c.index || empty_value(applicable: false), Array(c.written_by).any? ? c.written_by.join(', ') : empty_value(applicable: false)] } } %>
    </section>
    <section class="sec" aria-labelledby="dbh">
      <header><h2 class="t2" id="dbh">Database facts <%= count_tag('what the schema enforces') %></h2></header>
      <%= render 'woods_map/components/table', label: 'Database facts', columns: [{ label: 'fact', width: '240px', cell_class: 'nw id' }, { label: 'value' }, { label: 'source', width: '260px' }],
            rows: @schema.facts.map { |fact, value, source| { cells: [fact, value == 'none' || value.start_with?('none') ? tag.span(value, class: 'dim') : value, layer_chip(source)] } } %>
    </section>
    <%= render 'woods_map/shared/status', items: ['ER', 'model metadata', "gen #{@repository.generation_number}"], keys: [[%w[y], 'copy Mermaid'], [%w[/], 'search']] %>
  </div>
</div>
