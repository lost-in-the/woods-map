<%# Flows (B6-Impact-Flows) in range mode: the entry points Woods' report
    records through the changes (computed from the inverted flow membership,
    W-13), with each flow's steps when it belongs to the pinned generation.
    Locals: rr, range_url. %>
<% coverage = rr.coverage['flows'] || 'not recorded' %>
<section class="sec" aria-labelledby="flw" data-controller="rows">
  <header><h2 class="t2" id="flw">Flows <%= count_tag(rr.flows.size) %><%= info_tip("Entry points whose retained flow documents pass through a changed unit, as Woods' report records them from the inverted flow membership (W-13). Coverage: #{coverage}. Steps are drawn from the pinned generation's flow document; flows of another generation keep their route and changed units only.") %></h2><% if rr.flows.any? %><button class="tool goto" type="button" data-action="rows#expandAll" data-needs-js>expand all</button><% end %></header>
  <% if rr.flows.empty? %>
    <%= render 'woods_map/components/empty_state', title: 'No flow evidence recorded', text: "Woods recorded no retained flow through the changes (coverage: #{coverage}). Flows are precomputed per action only when the host enables precompute_flows, and membership is bounded by each document's depth; the Unknown tab says why when Woods could not read them. This is not a conclusive zero." %>
  <% else %>
    <%= render 'woods_map/impact/flow_table', flows: @flows, focus: rr.focus %>
  <% end %>
</section>
