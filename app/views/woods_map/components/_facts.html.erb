<%# Facts tiles (C5-Chrome): an eyebrow with a rule, then label / value rows.
    Locals: tiles (Array of Hash with :eyebrow and :rows, each row [label, value]). %>
<div class="facts">
  <% tiles.each do |tile| %>
    <div><span class="eyebrow"><%= tile[:eyebrow] %></span><dl><% tile[:rows].each do |label, value| %><dt><%= label %></dt><dd><%= value %></dd><% end %></dl></div>
  <% end %>
</div>
