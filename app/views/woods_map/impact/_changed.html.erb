<%# The Changed tab in pre-change mode: the focus units, then the affected units with the path that explains each. %>
<section class="sec" aria-labelledby="chg">
  <header><h2 class="t2" id="chg">Focus units <%= count_tag("#{r.focus.size} of #{@repository.status['total_units']}") %><%= info_tip('Pre-change mode (E-9): the units a planned change would touch, picked by the focus URL. With a range, Woods\' report lists the units whose source, metadata or dependency hashes moved (W-12).') %></h2><span class="goto tools"><%= render 'woods_map/components/mermaid_tools', text: r.mermaid, name: "impact #{r.focus.join(' ')}", url: woods_map.impact_mmd_path(request.query_parameters.slice('focus', 'depth', 'types', 'via', 'show')) %></span></header>
  <%= render 'woods_map/components/table', label: 'Focus units', min_width: '1000px',
             columns: [{ label: 'unit', width: '240px', cell_class: 'id', scroll: true }, { label: 'type', width: '110px', cell_class: 'nw mut' }, { label: 'recorded dependents', abbr: 'typed units with an edge to it in this generation; a hub note counts graph_analysis dependents per identifier', width: '200px', cell_class: 'num nw' }, { label: 'weight', width: '80px', cell_class: 'num nw' }, { label: 'notes', width: '250px' }, { label: 'flags', width: '70px', cell_class: 'nw' }],
             rows: r.focus.map { |id| flags = v.findings.count { |f| f.where == id }; { cells: [unit_link(id, r.type_of(id)), r.type_of(id).tr('_', ' '), pluralize(r.dependent_count(id), 'typed unit'), format('%.3f', r.weight(id)), r.notes(id).join(', ').presence || empty_value, flags.positive? ? safe_join([tag.span('⚑', class: 'flag'), " #{flags}"]) : empty_value] } } %>
</section>
<section class="sec" aria-labelledby="aff" data-controller="rows">
  <header><h2 class="t2" id="aff">Affected <%= count_tag("#{r.counted.size} within depth #{r.depth}, #{r.direct.size} direct, #{r.documentation.size} documentation") %><%= info_tip('Every unit the reverse edges reach from the focus, breadth first; open a row for the path that explains it (E-3). Weight is PageRank. The type and show controls filter; the status bar keeps the count before filtering.') %></h2><button class="tool goto" type="button" data-action="rows#expandAll" data-needs-js>expand all</button></header>
  <% if r.affected.empty? %>
    <%= render 'woods_map/components/empty_state', title: 'Nothing depends on the focus within this depth', text: 'No reverse edge reaches another unit, or the filters hid every one. Raise the depth or show every type.' %>
  <% else %>
    <% affected = WoodsMap::ListPage.new(r.affected, params[:page], per: WoodsMap::BlastRadius::LIST_PER_PAGE) %>
    <% families = affected.items.partition { |unit| unit.type != 'doc' } %>
    <% families.each_with_index do |family, family_index| %>
    <% next if family.empty? %>
    <% if family_index == 1 %><section aria-labelledby="docs"><h3 id="docs" class="t2">Documentation</h3><% end %>
    <% covering = v.tests.each_with_object(Hash.new { |h, k| h[k] = [] }) { |t, by| t.covers.each { |id| by[id] << t } } %>
    <% rows = family.map do |a| %>
      <% path = safe_join(a.path.map { |from, via, to| safe_join([unit_link(to, r.type_of(to)), ' ', tag.span(via, class: 'mut'), ' ', tag.span('←', class: 'ar'), ' ', unit_link(from, r.type_of(from))]) }, tag.br) %>
      <% specs = covering.fetch(a.identifier, []).uniq %>
      <% detail = tag.dl(safe_join([tag.dt('why affected'), tag.dd(path, class: 'p'), tag.dt('weight'), tag.dd(format('%.3f, %s', r.weight(a.identifier), r.notes(a.identifier).join(', ').presence || 'no analysis note')), (a.type == 'doc' ? nil : safe_join([tag.dt('covered by'), tag.dd(specs.any? ? safe_join(specs.map { |t| unit_link(t.spec, 'test_mapping') }, ', ') : 'no mapped test', class: 'p')]))].compact), class: 'det') %>
      <% { tip: identity_tip(a.identifier, a.type, a.via), cells: [unit_link(a.identifier, a.type), a.type.tr('_', ' '), a.distance == 1 ? 'direct' : "#{a.distance} hops", a.via, unit_link(a.from, r.type_of(a.from)), format('%.3f', r.weight(a.identifier)), r.notes(a.identifier).join(', ').presence || empty_value], detail: detail } %>
    <% end %>
    <%= render 'woods_map/components/table', label: (family_index == 1 ? 'Documentation units' : 'Affected units'), min_width: '1140px', grouped: true,
               columns: [{ label: 'unit', width: '240px', cell_class: 'id', scroll: true }, { label: 'type', width: '110px', cell_class: 'nw mut' }, { label: 'distance', width: '90px', cell_class: 'nw' }, { label: 'via', width: '130px', cell_class: 'nw' }, { label: 'from', width: '180px', scroll: true }, { label: 'weight', width: '80px', cell_class: 'num nw' }, { label: 'notes', width: '250px' }],
               rows: rows %>
    <% if family_index == 1 %></section><% end %>
    <% end %>
    <%= render 'woods_map/components/pager', list: affected, noun: 'affected units', anchor: 'aff' %>
  <% end %>
</section>
