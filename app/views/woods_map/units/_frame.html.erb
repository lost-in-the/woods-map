<%# The unit page frame (C5): crumbs, title block, tabs, facts tiles.
    Locals: page (UnitPage), tab (String), controls (HTML or nil), definition
    (Integer or nil: the file line of the definition, for the primary action),
    title and subtitle (Strings, the page's by default), tiles (Array of Hash
    with :eyebrow and rendered :rows, the page's tiles by default). %>
<%= render 'woods_map/shared/crumbs', crumbs: page.crumbs.map { |label, kind| [label, kind == :current ? nil : (kind ? woods_map.search_path(in: 'name', types: [kind]) : woods_map.search_path)] }, path: page.path, trail: tag.span('', data: { trail_target: 'list' }) %>
<% primary = local_assigns[:definition] ? link_to("Code at L#{local_assigns[:definition]}", "#{woods_map.unit_path(type: page.type, identifier: page.identifier)}#L#{local_assigns[:definition]}", class: 'btn primary') : nil %>
<%= render 'woods_map/shared/ident', title: local_assigns.fetch(:title, page.identifier), subtitle: local_assigns.fetch(:subtitle, page.subtitle), controls: safe_join([local_assigns[:controls], primary].compact, ' ') %>
<%= render 'woods_map/shared/tabs', tabs: unit_tabs(page, tab) %>
<% tiles = local_assigns[:tiles] || page.tiles.map { |tile| { eyebrow: tile[:eyebrow], rows: tile[:rows].map { |label, value| [label, tile_value(value)] } } } %>
<% if tiles.any? %><div style="margin:var(--s4) var(--s5) 0"><%= render 'woods_map/components/facts', tiles: tiles %></div><% end %>
