<%# The graph's timeline (A-6, W-3): the commits that touched the units
    drawn. With a script, a window of commits tints the units they touched;
    without one, the list below names them. Locals: timeline (GraphTimeline). %>
<% t = timeline %>
<section class="sec gtimeline" aria-labelledby="graph-timeline-title">
  <header><h2 class="t2" id="graph-timeline-title">Timeline <%= count_tag(t.table? ? "#{t.total} #{'commit'.pluralize(t.total)}, #{t.touched_units} of the units drawn" : 'no commit table') %><%= info_tip('Commits from this generation\'s commit table (Woods W-3) that touched the file or source paths of a unit drawn here, HEAD-reachable, newest first. Move the window to tint the units its commits touched.') %></h2></header>
  <% if !t.table? %>
    <p class="cap"><%= { absent: 'This generation has no commit table: Woods writes one when it extracts inside a git checkout.', unsupported: 'This Woods has no commit table reader (W-3).', unreadable: 'Woods refused this generation\'s commit table.' }.fetch(t.state, 'No commit table.') %></p>
  <% elsif t.commits.empty? %>
    <p class="cap">No commit in the table's window touched a unit drawn here.</p>
  <% else %>
    <div class="scrub" data-graph-target="scrub" hidden>
      <label class="f">from <input type="range" min="0" max="<%= t.commits.size - 1 %>" value="0" step="1" data-graph-target="scrubFrom" data-action="input->graph#scrub" aria-label="Window start, oldest commit first"></label>
      <label class="f">to <input type="range" min="0" max="<%= t.commits.size - 1 %>" value="<%= t.commits.size - 1 %>" step="1" data-graph-target="scrubTo" data-action="input->graph#scrub" aria-label="Window end, newest commit last"></label>
      <output class="cap" data-graph-target="window" aria-live="polite">Move the window to tint the units its commits touched.</output>
      <button class="tool" type="button" data-action="graph#clearWindow">clear</button>
    </div>
    <details class="gcommits">
      <summary>the <%= t.commits.size %> <%= 'commit'.pluralize(t.commits.size) %><%= " of #{t.total}" if t.total > t.commits.size %><%= ', the table stopped at its own bound' if t.truncated? %></summary>
      <%= render 'woods_map/components/table', label: 'Commits touching the units drawn', min_width: '720px',
            columns: [{ label: 'date', width: '96px' }, { label: 'commit', width: '128px' }, { label: 'message', width: '32%' }, { label: 'author', width: '16%' }, { label: 'units drawn' }],
            rows: t.commits.each_with_index.map { |c, i|
              position = t.commits.size - 1 - i
              { data: { commit: position },
                cells: [date_abbr(c.date),
                        safe_join([tag.code(short_sha(c.sha)), tag.button('tint', class: 'tool', type: 'button', 'aria-label': "Tint the units #{short_sha(c.sha)} touched", data: { action: 'graph#pickCommit', commit: position, needs_js: true })], ' '),
                        c.message.presence || empty_value, c.author.presence || empty_value,
                        safe_join(c.units.map { |identifier, type| unit_link(identifier, type) }, ', ')] }
            } %>
    </details>
  <% end %>
</section>
