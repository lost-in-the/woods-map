<% p = @passage %>
<% content_for :title, "#{@page.identifier}##{p.action} · Passage · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% passage_path = ->(action) { woods_map.unit_passage_path(type: @page.type, identifier: @page.identifier, action_name: action) } %>
<% controls = safe_join([tag.span('action', class: 'lbl'), tag.span(safe_join(p.actions.map { |a| link_to(a, passage_path.call(a), 'aria-current': (a == p.action ? 'true' : nil)) }), class: 'seg', role: 'group', 'aria-label': 'action')]) %>
<% applying = p.filters_for %>
<% before = applying.select { |f| f.kind == 'before' }; after = applying.select { |f| f.kind == 'after' }; around = applying.select { |f| f.kind == 'around' } %>
<% skipped = p.filters - applying %>
<% resolved = p.resolved? %>
<% moved_members = current_since&.changed_members(@unit) %>
<% filter_change = ->(f) { moved_members&.callback(f.since_entry, f.owner || @page.identifier) } %>
<% chain_chip = resolved ? 'resolved chain' : 'declared' %>
<% skipped_label = resolved ? 'skipped' : 'not declared' %>
<% condition_text = ->(f) { f.condition ? safe_join([' ', f.condition, ' ', layer_chip('conditional, not evaluated')]) : '' } %>
<% owner_text = ->(f) { resolved && f.owner && f.owner != @page.identifier ? safe_join([', from ', filter_owner(f.owner)]) : '' } %>
<% gem_text = ->(f) { f.gem? ? safe_join([' ', layer_chip('gem')]) : nil } %>
<% filter_text = ->(f) { safe_join([code_line_link(f.file, f.line, text: f.name), gem_text.call(f), (f.scope == 'every action' ? nil : " #{f.scope}"), owner_text.call(f), (resolved ? condition_text.call(f) : nil)].compact) } %>
<% tile_filter = ->(f) { safe_join([code_line_link(f.file, f.line, text: f.name), (resolved && f.condition ? " #{f.condition}" : nil)].compact) } %>
<% templates = p.action_templates; partials = p.templates - templates %>
<% template_link = ->(t) { moved = current_since&.change(t.identifier, 'view_template'); t.unit ? safe_join([(moved ? safe_join([chip(:modified), tag.span(" #{moved['status']} since gen #{current_since.from_generation}: ", class: 'sr-only')]) : nil), unit_link(t.identifier, 'view_template', since: (moved ? current_since.selector : nil))].compact, ' ') : tag.span(t.identifier, class: 'dim', title: 'not in the index') } %>
<% ivars = p.instance_variables_read %>
<% facts = p.facts; flags = p.flags; missing = p.missing_template_facts; unresolved = p.unresolved_renders; complete = p.coverage_complete? %>
<% unresolved_text = ->(u) { safe_join([tag.code(u.name), u.render_target? ? " in #{u.where}" : " in #{u.where}, #{u.kind}", (u.candidates.any? ? ", candidates #{u.candidates.join(', ')}" : nil), (u.line ? ' ' : nil), (u.line ? code_line_link(u.file, u.line, text: "L#{u.line}") : nil)].compact) } %>
<% ivs = ->(list) { safe_join(list.map { |v| tag.span(v, class: 'iv') }, ', ') } %>
<% unverified_keys = p.permitted_attributes.select { |pa| pa.model && pa.unverified.any? }.map { |pa| [pa.unverified.map(&:name), pa.model_name] } %>
<% partials_shown = p.templates.any? { |t| t.role == 'partial' } %>
<% locals = p.partial_locals; local_flags = locals.flags; used = facts ? facts.params.filter_map { |r| r['via'] } : p.permitted_attributes.map(&:method_name); param_flags = p.permitted_attributes.select { |pa| used.include?(pa.method_name) }.flat_map { |pa| pa.mismatches.map { |key| [key.name, pa.model_name] } }; extra_flags = param_flags.size + local_flags.size %>
<% writers_known = p.permitted_attributes.any?(&:writers_published?) %>
<% at_line = ->(fact) { code_line_link(fact['file'], fact['line'], text: "L#{fact['line']}") } %>
<% tiles = [] %>
<% if p.mailer? %>
  <% tiles << { eyebrow: 'Delivery', rows: [['action', "#{@page.identifier}.#{p.action}"], ['method', p.unit.dig('metadata', 'delivery_method').to_s.presence || empty_value], ['from', p.unit.dig('metadata', 'defaults', 'from').to_s.presence || empty_value], ['source', layer_chip('mailer metadata')]] } %>
<% else %>
  <% tiles << { eyebrow: 'Route', rows: [['verb', p.routes.any? ? safe_join(p.routes.map { |r| "#{r['verb']} #{r['path']}" }, tag.br) : 'no route'], ['helper', p.routes.filter_map { |r| r['name'] && "#{r['name']}_path" }.join(', ').presence || empty_value], ['declared', p.declared ? code_line_link(p.declared['file'], p.declared['line'], text: "L#{p.declared['line']}") : 'inherited'], ['source', layer_chip('routes, action_sources')]] } %>
<% end %>
<% tiles << { eyebrow: "Filters, #{applying.size} of #{p.filters.size} #{resolved ? 'apply' : 'declared'}", rows: [['before', (before + around).any? ? safe_join((before + around).map(&tile_filter), ', ') : 'none'], ['after', after.any? ? safe_join(after.map(&tile_filter), ', ') : 'none'], [skipped_label, skipped.any? ? skipped.map(&:name).join(', ') : 'none'], ['source', layer_chip(resolved ? 'resolved chain, W-8' : 'declared only/except; this generation has no resolved chain (W-8)')]] } %>
<% tiles << { eyebrow: "Renders #{p.templates.size}", rows: [['template', templates.any? ? safe_join(templates.map(&template_link), ', ') : 'none in the index'], ['partials', partials.any? ? safe_join(partials.uniq(&:identifier).map(&template_link), ', ') : 'none'], ['layout', p.layout || 'not in the index (W-7)'], ['source', layer_chip(facts ? 'per-action facts' : (p.mailer? ? 'mailer templates' : 'view_render edges, per-action renders are W-7'))]] } %>
<% flag_rows = if flags.nil?
                [['ivar mentions', ivars.any? ? ivs.call(ivars) : 'none'], ['rule', 'unassigned-ivar-read'], ['needs', 'assigns per action and filter, W-7'], ['source', layer_chip('template ivars')]]
              elsif flags.any?
                flags.map { |f| ['ivar', safe_join([tag.span(f.ivar, class: 'iv bad'), ', no recorded assignment'])] } + [['rule', 'unassigned-ivar-read'], ['source', layer_chip('template ivars + per-action facts')]]
              elsif !complete
                [['coverage', 'incomplete'], ['needs', unresolved.any? ? 'literal render targets, template ivar facts and complete partial chains' : 'template ivar facts and complete partial chains'], ['source', layer_chip('per-action facts')]]
              else
                [['ivar mentions', ivars.any? ? ivs.call(ivars) : 'none'], ['unmatched mentions', 'none in available facts'], ['rule', 'unassigned-ivar-read'], ['source', layer_chip('template ivars + per-action facts')]]
              end %>
<% extra_rows = param_flags.map { |key, model| ['param', safe_join([tag.span(key, class: 'iv bad'), ", no attribute on #{model}"])] } + local_flags.map { |f| ['local', safe_join([tag.span(f.local, class: 'iv bad'), ", passed to #{f.partial.delete_suffix('.html.erb')}, never read"])] } %>
<% tiles << { eyebrow: flags || extra_flags.positive? ? "Flags #{Array(flags).size + extra_flags}#{', incomplete' unless complete}" : 'Flags', rows: extra_rows + flag_rows } %>
<%= render 'woods_map/units/frame', page: @page, tab: 'passage', controls: controls, definition: p.declared&.dig('line') || @definition, title: "#{@page.identifier}##{p.action}", subtitle: p.request_label, tiles: tiles %>
<div class="body" data-controller="trail" data-trail-url-value="<%= trail_url %>" data-trail-title-value="<%= @page.identifier %>#<%= p.action %>">
  <%= render 'woods_map/components/rail', heading: 'Passage', groups: [
        { label: 'stages', count: 6, items: [
          { key: '·', text: 'request', own: p.request_label },
          { key: '·', text: 'filters', own: "#{applying.size} of #{p.filters.size} #{resolved ? 'apply' : 'declared'}" },
          { key: '·', text: 'action', own: p.declared ? "L#{p.declared['line']}" : (p.mailer? ? 'no line in the index' : 'inherited'), current: true },
          { key: '·', text: 'renders', own: "#{p.templates.size} #{'template'.pluralize(p.templates.size)}" },
          { key: '·', text: 'after', own: "#{after.size} #{'filter'.pluralize(after.size)}" },
          { key: '·', text: 'responds', own: p.formats.join(', ').presence || 'unknown' }
        ] },
        (also = [(p.mailer? || p.filters.empty? ? nil : { key: '·', text: 'filter matrix', href: '#fm' }), (@ladder ? { key: '·', text: 'callback ladder', own: "#{@ladder_model['identifier']}, #{@ladder_event}", href: '#cl' } : nil)].compact).any? ? { label: 'also here', count: also.size, items: also } : nil,
        (Array(flags).size + extra_flags).positive? ? { label: 'flags', count: Array(flags).size + extra_flags, items: Array(flags).map { |f| { key: tag.span('⚑', class: 'flag'), text: f.ivar, own: "mentioned in #{f.template}, no recorded assignment" } } + param_flags.map { |key, model| { key: tag.span('⚑', class: 'flag'), text: key, own: "permitted, no attribute on #{model}" } } + local_flags.map { |f| { key: tag.span('⚑', class: 'flag'), text: f.local, own: "passed to #{f.partial}, never read" } } } : nil,
        { label: 'limits', count: 3 + (writers_known ? 0 : 1) + (locals.published? ? 0 : 1), items: [
          (facts ? { key: '·', text: 'helpers the action calls are not followed', own: layer_chip('per-action facts') } : { key: '·', text: 'assigns, params read and renders per action', own: layer_chip('W-7, woods#757') }),
          (resolved || p.filters.empty? ? { key: '·', text: 'filter if/unless conditions are not evaluated', own: layer_chip('resolved chain') } : { key: '·', text: 'resolved filter chain and owners, not in this generation', own: layer_chip('W-8, re-extract') }),
          (writers_known ? nil : { key: '·', text: 'permitted keys against every model writer', own: layer_chip(WoodsMap::PermittedAttributes::WRITERS_ITEM) }),
          (locals.published? ? nil : { key: '·', text: 'partial locals passed and read', own: layer_chip(WoodsMap::Passage::LOCALS_ITEM) }),
          { key: '·', text: 'nothing here proves a path ran', own: layer_chip('static') }
        ].compact }
      ].compact %>
  <div class="main">
    <section class="sec" aria-labelledby="ps">
      <header><h2 class="t2" id="ps">Passage, <%= p.action %> <span class="n">request → filters → action → templates → response</span><%= info_tip(resolved ? 'Every row links to its line. Filters are the resolved chain for this action, inherited and concern-supplied ones included; an if/unless condition is shown, not evaluated. Available per-action facts supply assigns, params and renders.' : 'Every row links to its line. Filters are those whose declared only/except names this action; this generation has no resolved chain (W-8). Available per-action facts supply assigns, params and renders.') %></h2><span class="goto tools"><%= render 'woods_map/components/mermaid_tools', text: p.mermaid, name: "#{@page.identifier} #{p.action} passage", url: woods_map.unit_passage_mmd_path(type: @page.type, identifier: @page.identifier, action_name: p.action), key: 'y' %></span></header>
      <div class="psg">
        <div class="stage">request<b><%= p.request_label %></b></div>
        <div class="rows">
          <% p.path_params.each do |name| %><div><span>param</span><span><span class="iv"><%= name %></span> path <%= layer_chip('routes') %></span></div><% end %>
          <% p.permitted_attributes.each do |pa| %>
            <div><span>permits</span><span><code><%= pa.method_name %></code> → <%= unit_link(pa.model_name, 'model') %>: <%= pa.keys.map(&:name).join(', ') %> <%= layer_chip('permitted_params') %></span></div>
            <% if pa.model %>
              <% groups = pa.matched_by_fact.map { |via, names| safe_join(["#{via}: ", ivs.call(names)]) } %>
              <% groups << safe_join(['unverified: ', ivs.call(pa.unverified.map(&:name))]) if pa.unverified.any? %>
              <% groups << safe_join(['no attribute: ', safe_join(pa.mismatches.map { |k| tag.span(k.name, class: used.include?(pa.method_name) ? 'iv bad' : 'iv') }, ', ')]) if pa.mismatches.any? %>
              <div><span>attributes</span><span><%= safe_join(groups, ' · ') %> <%= layer_chip(pa.writers_published? ? 'model attribute_writers' : 'model metadata') %></span></div>
            <% else %>
              <div><span>attributes</span><span>no model <%= pa.model_name %> in the index, keys not checked</span></div>
            <% end %>
          <% end %>
          <% if p.path_params.empty? && p.permitted.empty? %><div><span>params</span><span>none declared</span></div><% end %>
          <div><span>format</span><span><%= p.formats.join(', ').presence || 'unknown' %></span></div>
        </div>
        <div class="stage">filters<b><%= before.size + around.size %> before, <%= after.size %> after</b></div>
        <div class="rows">
          <% (before + around).each do |f| %><div><span><%= f.kind %></span><span><%= filter_text.call(f) %><% if facts && facts.assigns_by(f.name).any? %>, assigns <%= safe_join(facts.assigns_by(f.name).map { |a| safe_join([tag.span(a['ivar'], class: 'iv'), ' ', at_line.call(a)]) }, ', ') %><% end %><% if facts && facts.redirects(f.name).any? %>, redirects to <code><%= facts.redirects(f.name).map { |r| r['target'] }.join(', ') %></code><% end %> <%= layer_chip(facts ? "#{chain_chip} + per-action facts" : chain_chip) %></span></div><% end %>
          <% skipped.each do |f| %><div><span><%= skipped_label %></span><span><%= f.name %>, <%= f.scope %><%= owner_text.call(f) %></span></div><% end %>
          <% if p.origin? %>
            <% { 'framework' => ['framework', 'hidden (Rails filters and procs)'], 'gem' => ['gem', 'procs hidden'], 'app' => ['app', 'procs not listed'], 'unknown' => ['unknown', 'hidden, origin unknown'] }.each do |origin, (label, what)| %><% count = p.hidden_filter_counts[origin] %><% if count %><div><span><%= label %></span><span><%= count %> <%= what %> <%= layer_chip("origin #{origin}") %></span></div><% end %><% end %>
          <% elsif p.framework_filter_count.positive? %><div><span>framework</span><span><%= p.framework_filter_count %> hidden (CSRF, origin, engine procs)</span></div><% end %>
          <% unless p.origin? || (p.framework_filter_count.zero? && p.filters.empty?) %><div><span>origin</span><span>no filter origin in this generation: framework filters are recognised by name, and a gem's filters are listed as the application's <%= layer_chip('origin, woods#936') %></span></div><% end %>
          <% if (before + around).empty? && skipped.empty? && p.framework_filter_count.zero? %><div><span>before</span><span><%= resolved ? 'none apply' : 'none declared' %></span></div><% end %>
        </div>
        <div class="stage" aria-current="true">action<b><%= p.action %><%= p.declared ? ", L#{p.declared['line']}" : '' %></b></div>
        <div class="rows">
          <div><span>defined in</span><span><%= p.declared ? code_line_link(p.declared['file'], p.declared['line']) : (p.mailer? ? 'the index records no action_sources for mailers (W-7)' : 'not in the controller source (inherited or a gem action)') %><% if p.declared && p.declared['owner'] != @page.identifier %> owner <%= unit_link(p.declared['owner'].to_s) %><% end %></span></div>
          <% if facts %>
            <% own = facts.assigns_by(p.action) %>
            <div><span>assigns</span><span><%= own.any? ? safe_join(own.map { |a| safe_join([tag.span(a['ivar'], class: 'iv'), ' ', at_line.call(a)]) }, ', ') : 'nothing' %> <%= layer_chip('per-action facts') %></span></div>
            <% reads = facts.params(p.action) %>
            <div><span>params read</span><span><%= reads.any? ? safe_join(reads.map { |r| safe_join([tag.span(r['via'] ? "#{r['via']} (#{r['key']})" : "params[:#{r['key']}]", class: 'iv'), ' ', at_line.call(r)]) }, ', ') : 'none' %></span></div>
            <% facts.redirects(p.action).each do |r| %><div><span>redirects</span><span><code><%= r['target'] %></code> <%= at_line.call(r) %></span></div><% end %>
            <% facts.other_renders.each do |r| %><div><span>responds</span><span><%= r['format'] ? "render #{r['format']}" : (r['head'] ? "head :#{r['head']}" : "render #{r['object']}") %><% if r['line'] %> <%= at_line.call(r) %><% end %><% if r['object'] %>, target unresolved <%= layer_chip('per-action facts') %><% end %></span></div><% end %>
            <div><span>in scope after</span><span><%= facts.assigned.any? ? safe_join(facts.assigns.uniq { |a| a['ivar'] }.map { |a| safe_join([tag.span(a['ivar'], class: 'iv'), " (#{a['method']})"]) }, ', ') : 'no instance variable' %></span></div>
          <% else %>
            <div><span>assigns</span><span>per-action assigns and reads are not published yet <%= layer_chip('W-7, woods#757') %></span></div>
          <% end %>
        </div>
        <div class="stage">renders<b><%= p.templates.size %> <%= 'template'.pluralize(p.templates.size) %></b></div>
        <div class="rows">
          <% p.templates.each do |t| %>
            <div><span><%= t.role %></span><span><%= safe_join(['↳ '] * t.depth) %><%= template_link.call(t) %><% if t.locals %> locals: <%= t.locals.any? ? ivs.call(t.locals) : 'none' %><% end %><% reads = t.unit&.dig('metadata', 'locals_read') %><% if reads.is_a?(Array) && t.role == 'partial' %>, reads <%= reads.any? ? ivs.call(reads) : 'no local' %><% end %><% if t.unit %><% if t.instance_variables.any? %> mentions <%= safe_join(t.instance_variables.map { |v| tag.span(v, class: 'iv') }, ', ') %><% end %><% if t.helpers.any? %>, <%= t.helpers.size %> <%= 'helper'.pluralize(t.helpers.size) %><% end %><% else %> <span class="dim">not in the index</span><% end %></span></div>
          <% end %>
          <% unresolved.each do |u| %><div><span>unresolved</span><span><%= u.render_target? ? 'render target ' : 'partial ' %><%= unresolved_text.call(u) %>, not resolved in the index</span></div><% end %>
          <% if p.templates.empty? && unresolved.empty? %><div><span>template</span><span>none tied to this action in the index</span></div><% end %>
          <div><span>layout</span><span><%= p.layout || 'not in the index (W-7)' %></span></div>
        </div>
        <div class="stage">after<b><%= after.size %> <%= 'filter'.pluralize(after.size) %></b></div>
        <div class="rows">
          <% after.each do |f| %><div><span>after</span><span><%= filter_text.call(f) %> <%= layer_chip(chain_chip) %></span></div><% end %>
          <% if after.empty? %><div><span>after</span><span><%= resolved ? 'none apply' : 'none declared' %></span></div><% end %>
        </div>
        <div class="stage last">responds<b><%= p.formats.join(', ').presence || 'unknown' %></b></div>
        <div class="rows">
          <% p.formats.each do |f| %><div><span><%= f %></span><span><%= p.mailer? ? "template #{templates.find { |t| t.identifier.include?(".#{f}.") }&.identifier || 'unknown'}" : (facts ? 'declared response format' : 'rendered template or redirect; per-action facts are W-7') %></span></div><% end %>
          <% if flags.nil? %>
          <div class="finding note"><span class="flag note">⚑</span> <b>No flag can be raised yet.</b> The unassigned-ivar-read rule needs the assigns of this action and its filters (W-7); available template ivar mentions are <%= ivars.any? ? safe_join(ivars.map { |v| tag.span(v, class: 'iv') }, ', ') : 'none' %>. <%= layer_chip("template ivars, gen #{@repository.generation_number}") %></div>
          <% elsif flags.any? %>
            <% flags.each do |f| %><div class="finding note"><span class="flag note">⚑</span> <b><%= tag.span(f.ivar, class: 'iv bad') %> is mentioned in <%= unit_link(f.template, 'view_template') %> with no recorded assignment in this action or its analyzed filter bodies.</b> <%= layer_chip("template ivars + per-action facts, gen #{@repository.generation_number}") %></div><% end %>
          <% elsif complete %>
            <div><span>ivar flags</span><span>none in available facts: every recorded template ivar mention has a recorded assignment <%= layer_chip('per-action facts') %></span></div>
          <% end %>
          <% unless complete %>
            <div class="finding note"><span class="flag note">⚑</span> <b>Flag coverage is incomplete.</b><% if missing.any? %> Template ivar facts or deeper partial chains are unavailable for <%= missing.join(', ') %>.<% end %><% if unresolved.any? %> The index does not resolve <%= safe_join(unresolved.map { |u| safe_join([u.render_target? ? 'render target ' : 'partial ', unresolved_text.call(u)]) }, '; ') %>; the templates behind <%= unresolved.one? ? 'it are' : 'them are' %> not checked.<% end %></div>
          <% end %>
          <% if unverified_keys.any? %>
            <div class="finding note"><span class="flag note">ⓘ</span> <b>Unverified, not flagged: <%= safe_join(unverified_keys.map { |keys, model| safe_join([ivs.call(keys), " for #{model}"]) }, '; ') %>.</b> No published column, association, attachment, rich-text field or class-body writer matches; <code>has_secure_password</code>, the attribute API, nested attributes and module writers are not published, so a missing attribute cannot be told from an unpublished writer. <%= layer_chip("permitted_params + model metadata, #{WoodsMap::PermittedAttributes::WRITERS_ITEM}") %></div>
          <% end %>
          <% param_flags.each do |key, model| %>
            <div class="finding note"><span class="flag note">⚑</span> <b><%= tag.span(key, class: 'iv bad') %> is permitted for <%= unit_link(model, 'model') %>, which publishes no attribute writer by that name.</b> Unless the action removes it first, mass assignment would raise <code>ActiveModel::UnknownAttributeError</code>. <%= layer_chip("permitted_params + attribute_writers, gen #{@repository.generation_number}") %></div>
          <% end %>
          <% local_flags.each do |f| %>
            <div class="finding note"><span class="flag note">⚑</span> <b><%= tag.span(f.local, class: 'iv bad') %> is passed to <%= unit_link(f.partial, 'view_template') %> from <%= f.from %><%= ":#{f.line}" if f.line %> and never read there by name.</b> <%= layer_chip("partial_renders + locals_read, gen #{@repository.generation_number}") %></div>
          <% end %>
          <% if partials_shown && !locals.published? %>
            <div class="finding note"><span class="flag note">ⓘ</span> <b>Partial locals are not checked.</b> The index publishes no local a partial reads, and no local a template passes to its partials; a local passed and never read cannot be found. <%= layer_chip(WoodsMap::Passage::LOCALS_ITEM) %></div>
          <% elsif locals.unchecked.any? %>
            <div class="finding note"><span class="flag note">ⓘ</span> <b>Partial locals not checked for <%= locals.unchecked.size %> <%= 'render'.pluralize(locals.unchecked.size) %>:</b> <%= safe_join(locals.unchecked.map { |u| "#{u.partial} from #{u.from}, #{u.why}" }, '; ') %>. <%= layer_chip('partial_renders + locals_read') %></div>
          <% end %>
          <% if locals.published? && (local_flags.any? || locals.unchecked.any?) %>
            <div class="finding note"><span class="flag note">ⓘ</span> Partial reads are lexical: a local read only through <code>local_assigns</code> with a computed key, or by a helper, is not seen.</div>
          <% end %>
          <% flow_gap = @repository.flow_failures.find { |f| f['entry_point'] == "#{@page.identifier}##{p.action}" } %>
          <% if flow_gap %>
            <div class="finding note"><span class="flag note">⚑</span> <b>The precomputed flow of <%= flow_gap['entry_point'] %> did not assemble.</b> Woods ran with <code>precompute_flows = :best_effort</code> and recorded it instead of aborting: <%= flow_gap['error'] %>. Flows through this action are not in the index. <%= layer_chip("#{flow_gap['reason']}, W-14") %></div>
          <% end %>
          <% if facts %>
            <div class="finding note"><span class="flag note">ⓘ</span> Template mentions are lexical and may include comments or template-local assignments. Helpers and filter conditions are not evaluated; these notes do not prove a runtime value.</div>
          <% end %>
        </div>
      </div>
    </section>
    <% dynamic = WoodsMap::DynamicView.new(@repository) unless p.mailer? %>
    <% if dynamic&.attributed? %>
      <% dyn_steps = @ladder_linked ? @ladder.steps(@ladder_event) : [] %>
      <% dyn_text = dynamic.passage(p, @ladder_linked && @ladder_model, dyn_steps, @ladder_linked && @ladder_event) %>
      <% dyn_refusal = WoodsMap::DynamicView.refusal(dyn_text) %>
      <section class="sec" aria-labelledby="c4">
        <header><h2 class="t2" id="c4">Across containers <span class="n">C4 dynamic</span><%= info_tip("The passage's steps in the containers W-9 attributes them to, as on the Landscape page. #{@ladder_linked ? "With the callback ladder's #{@ladder_event} of #{@ladder_model['identifier']}: its write in the database and the jobs and mailers it hands work to." : "The name of #{p.action} implies no model save, so nothing reaches the database here; the lifecycle below is related, not a step of it."}") %></h2></header>
        <%= render 'woods_map/components/diagram', title: 'C4 dynamic', facts: ["#{@page.identifier}##{p.action}", ("#{@ladder_model['identifier']} #{@ladder_event}" if @ladder_linked)].compact, name: "#{@page.identifier} #{p.action} passage dynamic", mermaid_url: woods_map.unit_passage_mmd_path(type: @page.type, identifier: @page.identifier, action_name: p.action, view: 'dynamic', event: (@ladder_linked ? @ladder_event : nil)), mermaid: dyn_text, label: "C4 dynamic view of #{@page.identifier}##{p.action}: the request in the web process#{@ladder_linked ? ", the #{@ladder_event} of #{@ladder_model['identifier']} and its write in the database" : ''}", refusal: dyn_refusal && "#{dyn_refusal}; the passage above lists every step.", legend: [['▭', 'a container, with its technology'], [tag.span('→', class: 'ar'), 'call or write; callback numbers match the ladder'], [tag.span('⇢', class: 'ar'), 'async hop to another container']], provenance: ['W-9 containers', "gen #{@repository.generation_number}"] %>
      </section>
    <% end %>
    <% unless p.mailer? || p.filters.empty? %>
      <section class="sec" aria-labelledby="fm" data-controller="matrix">
        <% if resolved %>
        <header><h2 class="t2" id="fm">Filter matrix <span class="n">chain order</span><%= info_tip('Resolved only/except per action (W-8), inherited and concern-supplied filters and skip_before_action included. A filter with an if/unless condition is marked conditional: Woods does not evaluate the condition, so its ✓ means it can run. Hover a ✓ for its condition; the current action\'s column is marked in the head.') %></h2></header>
        <% else %>
        <header><h2 class="t2" id="fm">Filter matrix <span class="n">declared scope</span><%= info_tip('A ✓ means the filter\'s declared only/except names the action. This generation has no resolved chain (W-8): skip_before_action, inherited and concern-supplied filters and conditions are not reflected. The current action\'s column is marked in the head.') %></h2></header>
        <% end %>
        <p class="cap matrix-tools" data-needs-js><button class="tool" type="button" aria-pressed="false" data-matrix-target="toggle" data-action="matrix#toggle">only filters on <%= p.action %></button> <span role="status" data-matrix-target="status"></span></p>
        <div class="tblwrap" role="region" aria-label="Filter matrix" tabindex="0" data-controller="cliff">
          <table class="tbl matrix fixed fit" aria-label="Filter matrix">
            <thead><tr><th width="200"><%= resolved ? 'filter, owner' : 'filter, declared in' %></th><% p.actions.each do |a| %><th class="c<%= ' cur' if a == p.action %>" width="66"><%= a %></th><% end %></tr></thead>
            <tbody>
              <% p.filters.each do |f| %>
                <% cell_title = resolved ? [f.condition, (f.scope == 'every action' ? nil : f.scope)].compact.join('; ').presence : nil %>
                <% change = filter_change.call(f) %>
                <tr<%= ' class="chg"'.html_safe if change %>><td class="id"><% if change %><%= chip(:modified, change == :method ? 'its method changed' : 'its declaration changed') %><span class="sr-only"> its <%= change %> changed since gen <%= current_since.from_generation %>: </span> <% end %><%= f.kind %> <%= code_line_link(f.file, f.line, text: f.name) %><%= gem_text.call(f) %><br><span class="mut regular"><% if resolved %><%= f.owner == @page.identifier ? f.owner : (filter_owner(f.owner).presence || 'owner not published') %><%= f.conditional? ? ", conditional: #{f.condition || 'if/unless'}" : '' %><% else %><%= f.file ? f.file.sub('app/controllers/', '') : f.scope %><%= f.file && f.scope != 'every action' ? ", #{f.scope}" : '' %><% end %></span></td><% p.actions.each do |a| %><% on = f.applies?(a) %><td class="c <%= on ? 'on' : 'off' %><%= ' cur' if a == p.action %>"<% if on && cell_title %> title="<%= cell_title %>"<% end %>><%= on ? '✓' : '·' %><% if on && f.conditional? %><span class="sr-only">, when <%= f.condition || 'its condition holds' %></span><% end %></td><% end %></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
    <% if @ladder %>
      <% ladder_steps = @ladder.steps(@ladder_event) %>
      <section class="sec" aria-labelledby="cl">
        <% if @ladder_linked %>
        <header><h2 class="t2" id="cl">Callback ladder, <%= unit_link(@ladder_model['identifier'], 'model') %> <span class="n">what a <%= @ladder_event %> runs</span><%= info_tip("Order is the resolved runtime chain, not file order. The model is the one #{p.permitted.any? ? 'the permitted params build' : 'the action references first'}; the event follows the action name, or pick one.") %></h2></header>
        <% else %>
        <header><h2 class="t2" id="cl">Related lifecycle, <%= unit_link(@ladder_model['identifier'], 'model') %> <span class="n">what a <%= @ladder_event %> runs</span><%= info_tip("The name of #{p.action} implies no model event, so this is not a step of #{p.action}. The model is the one #{p.permitted.any? ? 'the permitted params build' : 'the action references first'} and the event is picked by default; pick another. Nothing here says #{p.action} saves it.") %></h2></header>
        <p class="cap">Related lifecycle, not a step of <%= p.action %>: Woods does not say this action saves <%= @ladder_model['identifier'] %>. It shows what a <%= @ladder_event %> of that model runs.</p>
        <% end %>
        <div class="event-pick"><span class="lbl">event</span><span class="seg" role="group" aria-label="entry"><% WoodsMap::Lifecycle::EVENTS.each do |e| %><%= link_to(e, woods_map.unit_passage_path(type: @page.type, identifier: @page.identifier, action_name: p.action, event: e), 'aria-current': (e == @ladder_event ? 'true' : nil)) %><% end %></span></div>
        <%= render 'woods_map/units/ladder', steps: ladder_steps, owner: @ladder_model['identifier'], label: "Callback ladder, #{@ladder_model['identifier']} #{@ladder_event}", event: @ladder_event %>
      </section>
    <% end %>
    <%= render 'woods_map/shared/status', items: ['static: what the index declares, not what ran', (resolved ? 'resolved filter chain, routes, template ivars' : 'declared filters, routes, template ivars'), "gen #{@repository.generation_number}"], keys: [[%w[c u d], 'event'], [%w[y], 'copy Mermaid'], [%w[/], 'search']] %>
  </div>
</div>
