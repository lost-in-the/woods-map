<%# The top bar (C5-Chrome): ☰ below 960, wordmark, search, primary nav,
    freshness as ● + words, generation, SHA. Locals: generation (Hash or nil),
    freshness (Hash or nil), nav (Array of [label, href, current?]),
    search_path (String or nil), query (String or nil), label (landmark name). %>
<% nav = local_assigns[:nav] || primary_nav %>
<% fresh_class, fresh_words = freshness_words(local_assigns[:freshness].to_h['state'].to_s) %>
<% fresh_detail = freshness_detail(local_assigns[:freshness]) %>
<% bar_label = local_assigns.fetch(:label, 'Primary') %>
<% palette_id = bar_label == 'Primary' ? 'wm-palette' : "wm-palette-#{bar_label.parameterize}" %>
<header class="bar">
  <button class="tool menu-toggle" type="button" aria-label="Files and sections" aria-expanded="false" data-action="sheet#open" data-needs-js>☰</button>
  <a href="<%= woods_map.root_path %>" class="brand"><%= render 'woods_map/shared/mark' %>woods</a>
  <% if local_assigns.fetch(:search_path) { woods_map.search_path } %>
    <form class="bar-search" role="search" aria-label="<%= local_assigns.fetch(:label, 'Primary') == 'Primary' ? 'Search' : "Search, #{local_assigns[:label]}" %>" action="<%= local_assigns.fetch(:search_path) { woods_map.search_path } %>" method="get" data-controller="palette" data-palette-url-value="<%= woods_map.palette_path %>" data-action="submit->palette#submit"><span aria-hidden="true">⌕</span><input class="q" type="search" name="q" placeholder="Search units, files, routes, tables, code" aria-label="Search units, files, routes, tables, code" value="<%= local_assigns[:query] %>" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="<%= palette_id %>" data-palette-target="input" data-action="input->palette#open focus->palette#open click->palette#reopen keydown->palette#key"><span class="kbd" aria-hidden="true">/</span><div class="palette-wrap" hidden data-palette-target="wrap" data-action="click->palette#outside"><div class="palette" data-palette-target="panel"><div id="<%= palette_id %>" role="listbox" aria-label="Search palette" hidden></div></div></div></form>
  <% end %>
  <nav aria-label="<%= local_assigns.fetch(:label, 'Primary') %>"><% nav.each do |label, href, current| %><a href="<%= href %>"<%= ' aria-current="page"'.html_safe if current %>><%= label %></a><% end %></nav>
  <span class="bar-fresh">
    <% if generation %>
      <span class="why"<%= " title=\"#{ERB::Util.html_escape(fresh_detail)}\"".html_safe if fresh_detail %>><span class="<%= fresh_class %>">●</span><span class="w"> <%= fresh_words %></span></span>
      <span class="w">gen <b class="bright"><%= generation['generation'] %></b></span>
      <span class="w"><%= short_sha(generation['git_sha']) %></span>
    <% else %>
      <span><span class="dim">○</span><span class="w"> no index</span></span>
    <% end %>
  </span>
  <% if local_assigns.fetch(:label, 'Primary') == 'Primary' && guide_visible? %>
    <% if guide_status == :ready %><button class="btn guide-toggle" type="button" aria-controls="wm-guide" aria-expanded="false" aria-keyshortcuts="g" data-guide-target="toggle" data-action="guide#toggle" data-needs-js>Guide ▸</button>
    <% else %><button class="btn guide-toggle" type="button" disabled aria-describedby="wm-guide-why" title="<%= WoodsMap::Guide.notice(woods_map_config) %>">Guide ▸</button><span class="sr-only" id="wm-guide-why"><%= WoodsMap::Guide.notice(woods_map_config) %></span><% end %>
  <% end %>
  <% if local_assigns.fetch(:label, 'Primary') == 'Primary' %><button class="tool" type="button" aria-label="Keyboard shortcuts" aria-controls="wm-keyboard-help" aria-haspopup="dialog" aria-keyshortcuts="?" data-action="help#open" data-needs-js>?</button><% end %>
</header>
