<%# The Share menu (E-6, E-7): the page's focus URL and copies of the Mermaid
    text its diagram panels already carry. A native disclosure, so the URL
    is readable without JavaScript; copy actions need a script. No Markdown
    or JSON report: those stay with Woods (D-25, D-1). Locals: texts (Array of
    [label, url] or nil), stable text exports of the page's diagrams in other
    formats too, listed without a script. %>
<% url = focus_url %>
<details class="share" data-controller="share" data-action="toggle->share#toggle keydown->share#key">
  <summary class="btn">Share ▾</summary>
  <div class="share-panel" role="group" aria-label="Share this view">
    <div class="sh-row">
      <span class="eyebrow">focus URL</span>
      <button class="tool" type="button" data-controller="copy" data-copy-text-value="<%= url %>" data-share-target="copyUrl" data-action="copy#copy" data-needs-js>⎘ copy URL</button>
    </div>
    <code class="sh-url" data-share-target="url"><%= url %></code>
    <p class="cap sh-carries">The link carries this page and its query: the entry and pins. It does not carry notes, a conclusion or questions. A generation or hop count in the address is applied again on opening, not a frozen copy of what you saw.</p>
    <% if local_assigns[:texts].present? %>
      <div class="sh-dia sh-texts"><span class="eyebrow">text</span><% texts.each do |label, href| %><%= link_to label, href, class: 'tool', type: 'text/plain', rel: 'alternate', data: { share_text: true } %><% end %></div>
    <% end %>
    <div class="sh-dia" data-share-target="diagrams" hidden><span class="eyebrow">Mermaid</span></div>
  </div>
</details>
