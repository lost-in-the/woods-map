<% content_for :title, "#{@landscape.system_name} · Hotspots · Landscape · Woods Map" %>
<% h = @hotspots %>
<%= render 'woods_map/landscape/frame', crumb: 'hotspots' %>
<div class="body" data-controller="trail" data-trail-url-value="<%= trail_url %>">
  <div class="main landscape">
    <% if h.analysed? %>
      <% longest = h.cycles.max_by { |cycle| cycle.uniq.size } %>
      <%= render 'woods_map/components/facts', tiles: [
            { eyebrow: safe_join(['hubs ', tag.b(h.hubs.size)]), rows: [['rule', 'most dependents'], ['source', 'graph_analysis']] },
            { eyebrow: safe_join(['bridges ', tag.b(h.bridges.size)]), rows: [['meaning', 'single points of coupling']] },
            { eyebrow: safe_join(['cycles ', tag.b(h.cycles.size)]), rows: [['longest', longest ? "#{longest.uniq.size} units" : empty_value], ['example', longest ? longest.uniq.first(3).join(' ↔ ') : empty_value]] },
            { eyebrow: safe_join(['undeclared edges ', tag.b(h.undeclared_edges.size)]), rows: [['edge', h.undeclared_edges.first ? "#{h.undeclared_edges.first['from_package']} → #{h.undeclared_edges.first['to_package']}" : empty_value], ['finding', h.undeclared_edges.any? ? chip(:blocking, 'blocking') : empty_value]] },
            { eyebrow: safe_join(['orphans ', tag.b(h.orphans.size)]), rows: [['no dependents', h.orphans.size.to_s], ['dead ends', "#{h.dead_ends.size}, no dependencies"]] },
            { eyebrow: safe_join(['uncovered hubs ', tag.b(h.uncovered_hubs.size)]), rows: [['unit', h.uncovered_hubs.first ? unit_link(h.uncovered_hubs.first['identifier'], h.uncovered_hubs.first['type']) : empty_value], ['finding', 'no mapped test']] }
          ] %>
      <% risks = h.risks %>
      <% if risks.any? %>
        <p class="cap named-findings">Named findings: <%= safe_join(risks.select(&:type).first(3).map { |risk| safe_join([risk.kind, ' ', unit_link(risk.identifier, risk.type)]) }, ', ') %>. <%= link_to("all #{risks.size} under Structural risk", '#structural-risk') %></p>
      <% end %>
      <section class="sec">
        <header><h2 class="t2">Hotspots <%= count_tag('churn × dependents') %><%= info_tip('Commits per unit come from Woods\' git enrichment of this generation; dependents from the graph. The most changed and most depended upon come first: review those first.') %></h2></header>
        <% if h.churn? %>
          <% churn = h.churn %>
          <%= render 'woods_map/components/diagram', title: 'Churn × dependents', facts: ["#{churn.size} units, numbered as the table ranks them", 'x = commits, y = dependents, log scale', 'review the top right first'],
                name: 'landscape hotspots quadrant', mermaid_url: woods_map.landscape_diagram_mmd_path(diagram: 'quadrant'), mermaid: h.quadrant_mermaid,
                label: "Quadrant of #{churn.size} units by commits and dependents; the table below ranks the same units",
                legend: [[tag.span('·', class: 'ar'), 'unit, by its rank in the table; 3/7 share a position'], ['', 'x = commits against the most changed'], ['', 'y = dependents, log scale']],
                provenance: ['commit_count on graph nodes', 'graph', "gen #{@repository.generation_number}"] %>
          <%= render 'woods_map/components/table', label: 'Hotspots', min_width: '560px', columns: [{ label: '#', width: '48px' }, { label: 'unit', width: '40%' }, { label: 'commits', width: '16%' }, { label: 'dependents', width: '16%' }, { label: 'change frequency' }],
                rows: churn.each_with_index.map { |row, index| { cells: [(index + 1).to_s, unit_link(row[:identifier], row[:type]), row[:commits].to_s, row[:dependents].to_s, row[:change_frequency] || empty_value(applicable: false)] } } %>
        <% else %>
          <%= render 'woods_map/components/empty_state', title: 'No commit history in this generation', text: 'Woods records commits per unit when it extracts inside a git checkout. This generation carries none, so churn cannot be weighed against dependents; the structure below still reads.' %>
        <% end %>
      </section>
      <section class="sec">
        <% coupling = h.coupling %>
        <header><h2 class="t2">Coupling between layers <%= count_tag('edges, from row to column') %><%= info_tip('Published typed edges between unit types, leaving out test coverage, route exercise, documentation and migration bookkeeping.') %></h2></header>
        <% if coupling.any? %>
          <% columns = WoodsMap::Hotspots::LAYERS.select { |to| coupling.values.any? { |row| row[to].positive? } } %>
          <%= render 'woods_map/components/table', label: 'Coupling between layers', min_width: "#{((180 + (columns.size * 110)) / 20.0).ceil.clamp(24, 60) * 20}px",
                columns: [{ label: 'from', width: '180px' }] + columns.map { |to| { label: to.tr('_', ' ').pluralize } },
                rows: coupling.map { |from, row| { cells: [tag.b(from.tr('_', ' ').pluralize)] + columns.map { |to| row[to].positive? ? row[to].to_s : WoodsMap::Glyphs[:none] } } } %>
        <% else %>
          <p class="cap">No edges between these layers in this generation.</p>
        <% end %>
      </section>
      <section class="sec">
        <% flow = h.forward_flow %>
        <header><h2 class="t2">Forward flow <%= count_tag('the same edges, layering direction only') %><%= info_tip('The coupling above, keeping only edges from a layer to a later one (controllers, views, components, jobs, mailers, models), so the flow reads one way. Edges that run back up the layers are in the matrix, not here.') %></h2></header>
        <% if flow.any? %>
          <%= render 'woods_map/components/diagram', title: 'Forward flow', facts: ["#{flow.size} #{'flow'.pluralize(flow.size)}", "#{flow.sum(&:last)} edges"],
                name: 'landscape forward flow', mermaid_url: woods_map.landscape_diagram_mmd_path(diagram: 'sankey'), mermaid: h.sankey_mermaid,
                label: "Sankey of published edges between layers, layering direction only: #{flow.map { |from, to, n| "#{from} to #{to} #{n}" }.join(', ')}",
                provenance: ['typed edges', "gen #{@repository.generation_number}"] %>
        <% else %>
          <p class="cap">No edge runs forward between these layers in this generation.</p>
        <% end %>
      </section>
      <section class="sec">
        <% sizes = h.code_sizes %>
        <% what = WoodsMap::CodeSizes::METRICS[h.metric] %>
        <header>
          <h2 class="t2">Where the code is <%= count_tag(sizes.any? ? "#{h.sized_by_package? ? "#{sizes.size} #{'package'.pluralize(sizes.size)}" : 'the application'} by #{what}, #{number_with_delimiter(sizes.values.sum { |types| types.values.sum })}" : 'nothing to size by') %><%= info_tip('Sized by lines of code (lines with anything but whitespace, each distinct file once, from Woods\' source sizes, woods#810), by the number of application units, or by their summed PageRank × 1000; by Packwerk package when the generation has packages, otherwise the application as one block; within a block by unit type.') %></h2>
          <span class="seg" role="group" aria-label="Size the treemap by"><% WoodsMap::CodeSizes::METRICS.each do |key, label| %><%= link_to(label.sub(' × 1000', ''), woods_map.landscape_path(tab: 'hotspots', size: (key == 'loc' ? nil : key)), 'aria-current': (h.metric == key ? 'true' : nil)) %><% end %></span>
        </header>
        <% if sizes.any? %>
          <%= render 'woods_map/components/diagram', title: 'Where the code is', facts: [h.sized_by_package? ? 'by package' : 'one block, no packages', 'then by unit type', "size = #{what}"],
                name: "landscape treemap #{h.metric}", mermaid_url: woods_map.landscape_diagram_mmd_path(diagram: 'treemap', size: (h.metric == 'loc' ? nil : h.metric)), mermaid: h.treemap_mermaid,
                label: "Treemap by #{what}: #{sizes.map { |block, types| "#{block} #{types.values.sum}" }.join(', ')}; the table below has each figure",
                provenance: [h.metric == 'loc' ? (h.sized_by_package? ? 'graph_analysis package_sizes' : 'graph node loc') : (h.metric == 'units' ? 'graph nodes with a container' : 'graph pagerank'), "gen #{@repository.generation_number}"] %>
          <%= render 'woods_map/components/table', label: "#{what.capitalize} by block and type", min_width: '560px',
                columns: [{ label: h.sized_by_package? ? 'package' : 'block', width: '30%' }, { label: what, width: '14%' }, { label: 'by unit type' }],
                rows: sizes.map { |block, types| { cells: [tag.b(block), number_with_delimiter(types.values.sum), types.sort_by { |t, n| [-n, t] }.map { |t, n| "#{t.tr('_', ' ').pluralize} #{number_with_delimiter(n)}" }.join(', ')] } } %>
        <% elsif h.metric == 'loc' %>
          <%= render 'woods_map/components/empty_state', title: 'No source sizes in this generation', text: safe_join(['Woods publishes the lines of code of each application unit\'s file from ', link_to('woods#810', 'https://github.com/lost-in-the/woods/issues/810'), '. Extract again with a Woods that includes it, or size by unit count or PageRank.']) %>
        <% else %>
          <%= render 'woods_map/components/empty_state', title: 'No application units to size', text: 'This generation has no container attribution (W-9), which marks the application\'s own units.' %>
        <% end %>
      </section>
      <section class="sec" id="structural-risk">
        <header><h2 class="t2">Structural risk <%= count_tag(risks.size) %><%= info_tip('From graph_analysis.json, scoped to identifiers as Woods publishes it. Nothing here proves a path ran.') %></h2></header>
        <% if risks.any? %>
          <%= render 'woods_map/components/table', label: 'Structural risk', min_width: '720px', columns: [{ label: 'kind', width: '16%' }, { label: 'unit', width: '30%' }, { label: 'why' }, { label: 'do', width: '16%' }],
                rows: risks.map { |risk| { cells: [risk.kind, risk.type ? unit_link(risk.identifier, risk.type) : risk.identifier, risk.why, safe_join([(chip(risk.severity == :blocking ? :blocking : :note, risk.severity.to_s) if risk.severity == :blocking), risk.action].compact, ' ').presence || empty_value(applicable: false)] } } %>
        <% else %>
          <p class="cap">The analysis finds nothing to flag.</p>
        <% end %>
      </section>
    <% else %>
      <%= render 'woods_map/components/empty_state', title: 'No graph analysis in this generation', text: 'graph_analysis.json is absent, so there are no hubs, bridges or cycles to show. A full extraction writes it.' %>
    <% end %>
    <%= render 'woods_map/shared/status', items: ['graph_analysis + graph', "gen #{@repository.generation_number}", 'nothing here proves a path ran'], keys: [[%w[/], 'search']] %>
  </div>
</div>
