<% content_for :title, "#{@page.identifier} · Lifecycle · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% chains = @lifecycle.chains %>
<% steps = @lifecycle.steps(@event) %>
<% controls = safe_join([tag.span('entry', class: 'lbl'), tag.span(safe_join(WoodsMap::Lifecycle::EVENTS.map { |e| link_to(e, woods_map.unit_lifecycle_path(type: @page.type, identifier: @page.identifier, event: e), 'aria-current': (e == @event ? 'true' : nil)) }), class: 'seg', role: 'group', 'aria-label': 'entry')]) %>
<%= render 'woods_map/units/frame', page: @page, tab: 'lifecycle', controls: controls, definition: @definition %>
<div class="body" data-controller="trail" data-trail-title-value="<%= @page.identifier %>">
  <%= render 'woods_map/components/rail', heading: 'Lifecycle, as Rails runs it', groups: [
        { label: 'events', count: 'steps', items: chains.map { |event, list| { key: '·', text: link_to(event, woods_map.unit_lifecycle_path(type: @page.type, identifier: @page.identifier, event: event)), own: "#{list.size} #{'step'.pluralize(list.size)}#{list.any?(&:async?) ? ', async' : ''}", current: event == @event } } },
        { label: 'limits', count: 3, items: [{ key: '·', text: "#{@lifecycle.framework.size} framework #{'callback'.pluralize(@lifecycle.framework.size)} hidden", own: layer_chip('not defined here') }, { key: '·', text: 'proc callbacks are not analysed', own: layer_chip('CallbackAnalyzer') }, { key: '·', text: 'nothing here proves a path ran', own: layer_chip('static') }] }
      ] %>
  <div class="main">
    <% mermaid = @lifecycle.mermaid(@event) %>
    <section class="sec">
      <%= render 'woods_map/components/diagram', title: 'Sequence', facts: ["#{@page.identifier} #{@event}", "#{steps.size} steps"], name: "#{@page.identifier} lifecycle #{@event}", mermaid_url: woods_map.unit_lifecycle_mmd_path(type: @page.type, identifier: @page.identifier, event: @event), mermaid: mermaid, label: "Sequence of the #{@event} callbacks on #{@page.identifier}, numbered as in the steps below", refusal: (@lifecycle.refusal(@event) && "#{@lifecycle.refusal(@event)}; the steps below list every one."), legend: [[tag.span('→', class: 'ar'), 'call, same process'], [tag.span('⇒', class: 'ar'), 'async hop: a new process; the transaction has ended'], ['', 'numbers match the steps below']], provenance: ['resolved chain', "gen #{@repository.generation_number}"] %>
    </section>
    <section class="sec" aria-labelledby="ladder">
      <header><h2 class="t2" id="ladder">Steps for <%= @event %> <%= count_tag("#{steps.size} steps, in the order Rails runs them") %><%= info_tip('Order is the resolved runtime chain, not file order. Side effects come from a regex analysis of the callback body; a proc callback is skipped.') %></h2></header>
      <%= render 'woods_map/units/ladder', steps: steps, owner: @page.identifier, label: "Steps for #{@event}", event: @event %>
    </section>
    <%= render 'woods_map/shared/status', items: ['sequence', 'numbers match the steps', "gen #{@repository.generation_number}"], keys: [[%w[c u d], 'event'], [%w[y], 'copy'], [%w[/], 'search']] %>
  </div>
</div>
