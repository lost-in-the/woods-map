<% content_for :title, "#{@page.identifier} · History · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% h = @history %>
<% gens = h.generation_numbers %>
<% diff_pair = gens.size >= 2 ? gens.last(2) : nil %>
<% author_url = ->(name) { history_tab_url(@page, author: name, week: nil, gen: nil, all: nil, anchor: 'commits') } %>
<% by_author = h.author ? " by #{h.author}" : '' %>
<% range_seg = tag.span(class: 'seg', role: 'group', 'aria-label': 'Range') do %><% WoodsMap::HistoryView::RANGES.each_key do |key| %><%= link_to(key, history_tab_url(@page, range: key, week: nil, span: nil), 'aria-current': (h.range == key ? 'true' : nil)) %><% end %><% end %>
<% by_seg = h.table? ? tag.span(class: 'seg', role: 'group', 'aria-label': 'Group commits by') { safe_join(WoodsMap::HistoryView::BY.map { |key| link_to(key, history_tab_url(@page, by: (key == WoodsMap::HistoryView::BY.first ? nil : key), week: nil, gen: nil, span: nil, anchor: 'commits'), 'aria-current': (h.by == key ? 'true' : nil)) }) } : nil %>
<% diff_link = diff_pair && link_to("Diff gen #{diff_pair.first} → #{diff_pair.last}", history_tab_url(@page, from: diff_pair.first, to: diff_pair.last, anchor: 'diff'), class: 'btn primary') %>
<%= render 'woods_map/units/frame', page: @page, tab: 'history', definition: (diff_link ? nil : @definition), controls: safe_join([tag.span('range', class: 'mut'), range_seg, (by_seg && tag.span('by', class: 'mut')), by_seg, diff_link].compact, ' ') %>
<div class="body" data-controller="trail" data-trail-title-value="<%= @page.identifier %>">
  <% groups = [] %>
  <% if h.table? && h.generations.any? %>
    <% groups << { label: "generations touching #{@page.identifier}", count: h.generations.size, items: h.generations.map { |g| { key: g.number, text: short_sha(g.head), own: safe_join([(g.extracted_at ? date_abbr(g.extracted_at) : nil), (g.baseline ? 'and earlier' : nil), (@repository.retention.pinned?(g.number) ? 'pinned' : nil)].compact, ', '), current: g.number == @repository.generation_number } } } %>
  <% end %>
  <% groups << { label: 'people', count: h.people.size, items: h.people.map { |p| { key: p.commits, text: who(p.name, href: author_url.call(p.name)), current: p.name == h.author, own: (p.last ? safe_join(['last ', date_abbr(p.last)]) : nil) } } } %>
  <% if h.co_changes.any? %>
    <% groups << { label: 'moves with, co-change', count: h.co_changes.size, items: h.co_changes.map { |c| { key: c.commits, text: c.identifier, href: woods_map.unit_history_path(type: c.type, identifier: c.identifier), own: c.type.tr('_', ' ') } } } %>
  <% end %>
  <% groups << { label: 'limits', count: h.limits.size, items: h.limits.map { |l| { key: '·', text: l } } } %>
  <%= render 'woods_map/components/rail', heading: "History, HEAD-reachable, #{h.days}d", groups: groups %>
  <div class="main">
    <% if @diff %>
      <section class="sec" aria-labelledby="diff-title" id="diff">
        <header><h2 class="t2" id="diff-title">Unit diff <%= count_tag("gen #{@diff.from} → #{@diff.to}") %><%= info_tip('This unit\'s record in Woods\' change impact report between two retained generations (Woods::Impact::Report, W-12): which facets moved, the categories and metadata keys, the source size; then Woods\' unified diff of its annotated source (Woods::Impact::UnitDiff). Line numbers are the source the map shows, concerns and schema header included.') %></h2><%= link_to('full range report', woods_map.impact_path(from: "gen:#{@diff.from}", to: "gen:#{@diff.to}"), class: 'tool goto') %></header>
        <% case @diff.state %>
        <% when :changed %>
          <%= render 'woods_map/components/detail', rows: @diff.rows, framed: true %>
          <% src = @diff.source %>
          <% if src.state == :available && src.hunks.any? %>
            <% counts = src.changes %>
            <%= render 'woods_map/components/diff', name: @page.path || @page.identifier, hunks: src.hunks, coverage: counts['coverage'],
                       eyebrow: "diff, #{@page.identifier}, #{counts['added_lines']} #{counts['added_lines'] == 1 ? 'line' : 'lines'} added, #{counts['removed_lines']} removed" %>
          <% elsif src.state == :available %>
            <%= render 'woods_map/components/diff', name: @page.identifier, hunks: [], coverage: src.changes['coverage'], eyebrow: "diff, #{@page.identifier}: the annotated source did not change" %>
          <% else %>
            <p class="cap"><%= src.message %></p>
          <% end %>
        <% when :unchanged %>
          <%= render 'woods_map/components/empty_state', title: "#{@page.identifier} did not change between gen #{@diff.from} and gen #{@diff.to}", text: 'Woods\' report lists no change to its source, metadata or dependencies.' %>
        <% else %>
          <%= render 'woods_map/components/banner', severity: :warn, lead: 'No comparison.', text: @diff.message %>
        <% end %>
      </section>
    <% end %>
    <% if h.table? %>
      <% strip = h.strip %>
      <% by_gen = h.by == 'generation' %>
      <% bar_url = by_gen ? ->(number) { history_tab_url(@page, by: 'generation', gen: number, week: nil, span: nil, all: nil, anchor: 'commits') } : ->(first) { history_tab_url(@page, week: first.iso8601, gen: nil, span: nil, all: nil, anchor: 'commits') } %>
      <% strip_label = by_gen ? "#{strip.total} commits touching #{h.paths_label} #{by_author} in #{h.days} days by the retained generation that first carried them, #{strip.recent_total} in gen #{@repository.generation_number}" : "#{strip.total} commits touching #{h.paths_label}#{by_author} in #{h.days} days, #{strip.recent_total} in the last 4 weeks" %>
      <% legend = by_gen ? [[tag.span('▮', class: 'sw-bar'), 'commits first carried by a retained generation'], [tag.span('▮', class: 'sw-recent'), "gen #{@repository.generation_number}, this one"]] : [[tag.span('▮', class: 'sw-bar'), "commits per #{strip.step == 1 ? 'day' : 'week'}"], [tag.span('▮', class: 'sw-recent'), 'last 4 weeks'], [tag.span('┆', class: 'sw-gen'), 'generation extracted'], [tag.span('↔', class: 'brush-hint', data: { needs_js: true }), 'drag across bars, or Shift+←/→ on a bar then Enter, to pick a span']] %>
      <% exports = h.any? ? safe_join(['XY chart ', render('woods_map/components/mermaid_tools', text: h.mermaid('xychart').to_s, name: "#{@page.identifier} history xychart", url: woods_map.unit_history_mmd_path(type: @page.type, identifier: @page.identifier, view: 'xychart', range: h.range)), ' · timeline ', render('woods_map/components/mermaid_tools', text: h.mermaid('timeline').to_s, name: "#{@page.identifier} history timeline", url: woods_map.unit_history_mmd_path(type: @page.type, identifier: @page.identifier, range: h.range))]) : nil %>
      <%= render 'woods_map/components/diagram', title: (by_gen ? 'Commits by generation' : 'Commits'), facts: [h.paths_label, ("by #{h.author}" if h.author), "#{strip.total} in #{h.days}d", (by_gen ? "#{strip.recent_total} in gen #{@repository.generation_number}" : "#{strip.recent_total} in 4 weeks")].compact,
                 body: render('woods_map/history/strip', strip: strip, bar_url: bar_url, selected: (by_gen ? h.gen : (h.span || h.week)), label: strip_label,
                              brush_url: (by_gen ? nil : history_tab_url(@page, span: '__SPAN__', week: nil, gen: nil, all: nil, anchor: 'commits'))),
                 legend: legend, provenance: [exports].compact %>
    <% end %>
    <section class="sec" aria-labelledby="commits-title" id="commits" data-controller="rows">
      <% shown = h.commits %>
      <% heading = if h.span && h.table? then "#{shown.size} from #{h.span.first.iso8601} to #{h.span.last.iso8601}"
                   elsif h.gen && h.table? then "#{shown.size} first carried by gen #{h.gen}"
                   elsif h.week then "#{shown.size} in the #{h.commit_strip&.step == 1 ? 'day' : 'week'} of #{h.week.iso8601}"
                   elsif h.all? || shown.size == h.total then "#{h.total} in #{h.days}d"
                   else "latest #{shown.size} of #{h.total}"
                   end %>
      <header><h2 class="t2" id="commits-title">Commits <%= count_tag(heading) %><%= info_tip(h.table? ? 'Every HEAD-reachable commit in the window that touched this unit\'s file or a file it inlines, from the generation\'s commit table (Woods W-3). Open a row for its description, files, hunks and the units that changed with it. Facets moved is Woods\' record of this unit between the generation that first carried the commit and the retained generation before it (Woods::Impact::UnitDiff); a commit between extractions is attributed to the next generation.' : 'The last commits the extractor recorded for this unit (metadata.git); this generation has no commit table.') %></h2>
        <span class="goto tools"><% if h.span && h.table? %><%= link_to('whole window', history_tab_url(@page, span: nil, anchor: 'commits'), class: 'tool') %><% elsif h.gen && h.table? %><%= link_to('all generations', history_tab_url(@page, gen: nil, anchor: 'commits'), class: 'tool') %><% elsif h.week %><%= link_to('all weeks', history_tab_url(@page, week: nil, anchor: 'commits'), class: 'tool') %><% elsif h.table? && !h.all? && shown.size < h.total %><%= link_to("all #{h.total}", history_tab_url(@page, all: '1', anchor: 'commits'), class: 'tool') %><% end %><% if h.table? && shown.any? %> <button class="tool" type="button" data-action="rows#expandAll" data-needs-js>expand all</button><% end %><% if h.table? && !h.author %> <%= link_to('timeline with what moves with it', woods_map.history_path(units: (["#{@page.type}:#{@page.identifier}"] + h.co_changes.first(3).map { |c| "#{c.type}:#{c.identifier}" }), range: h.range), class: 'tool') %><% end %></span></header>
      <% neighbourhood = ["#{@page.type}:#{@page.identifier}"] + h.co_changes.first(3).map { |c| "#{c.type}:#{c.identifier}" } %>
      <% if h.author %>
        <p class="cap" role="status">Only commits by <%= who(h.author) %>, as git recorded the name. <%= link_to('all authors', history_tab_url(@page, author: nil)) %><% if h.table? %> · <%= link_to('their commits across the neighbourhood', woods_map.history_path(units: neighbourhood, range: h.range, author: h.author)) %><% end %></p>
      <% end %>
      <% if shown.any? %>
        <% own = [@page.identifier, @page.type] %>
        <% columns = [{ label: 'when', width: '64px', cell_class: 'nw' }, { label: 'sha', width: '84px', cell_class: 'nw mut' }, { label: 'author', width: '150px' }, { label: 'message', cell_class: 'id' }] %>
        <% columns += [{ label: 'files, units', width: '170px', cell_class: 'nw' }, { label: 'gen', width: (since_generation ? '84px' : '60px'), cell_class: 'num nw', abbr: 'generation that first carried the commit' }] if h.table? %>
        <% moved = h.table? && h.facets.available? %>
        <% columns += [{ label: 'facets moved', width: '170px', abbr: 'what Woods recorded moving in this unit at the generation that first carried the commit' }] if moved %>
        <% rows = shown.map do |c| %>
          <% cells = [date_abbr(c.date), tag.span(short_sha(c.sha), title: c.sha), who(c.author, href: author_url.call(c.author)), c.message] %>
          <% cells += [files_and_units(c), commit_generation(c.generation)] if h.table? %>
          <% cells << (h.facets_moved(c) || empty_value) if moved %>
          <% { cells: cells, classes: (since_commit?(c.generation) ? 'chg' : nil), detail: (h.table? ? commit_detail(c, own: own) : nil) } %>
        <% end %>
        <%= render 'woods_map/components/table', label: 'Commits', min_width: (moved ? '920px' : '760px'), columns: columns, rows: rows, grouped: h.table?,
                   caption: safe_join(["HEAD-reachable, last change ", date_abbr(h.last_modified), (since_generation ? "; #{shown.count { |c| since_commit?(c.generation) }} shown arrived after gen #{since_generation}, marked M" : nil)].compact) %>
      <% elsif h.author %>
        <%= render 'woods_map/components/empty_state', title: "No commits by #{h.author} touched #{h.paths_label} in #{h.days} days", text: 'The author filter matches the name exactly as git recorded it. Show all authors, or try the longer range.' %>
      <% elsif h.any? %>
        <%= render 'woods_map/components/empty_state', title: 'No commits in this bar', text: 'Pick another bar of the strip, or list every week.' %>
      <% elsif h.table? %>
        <%= render 'woods_map/components/empty_state', title: "No commits touched #{h.paths_label} in #{h.days} days", text: 'The commit table lists every HEAD-reachable commit in its window that touched an indexed file; none touched this unit\'s files. Try the longer range.' %>
      <% else %>
        <%= render 'woods_map/components/empty_state', title: 'No git facts for this unit', text: 'The extraction ran without git history for this file (a container without .git, or a file outside the repository).' %>
      <% end %>
    </section>
    <% if gens.size >= 2 %>
      <section class="sec" aria-labelledby="gens">
        <header><h2 class="t2" id="gens">Generations <%= count_tag("#{gens.size} retained") %><%= info_tip('Compare this unit between two retained generations. The comparison is Woods\' change impact report; the map derives nothing.') %></h2></header>
        <form class="impact-range-form" method="get" action="<%= woods_map.unit_history_path(type: @page.type, identifier: @page.identifier, anchor: 'diff') %>">
          <% if h.range %><input type="hidden" name="range" value="<%= h.range %>"><% end %>
          <label class="lbl" for="diff-from">from</label>
          <select id="diff-from" name="from" class="filter auto"><% gens.each do |n| %><option value="<%= n %>"<%= ' selected'.html_safe if n == (@diff&.from || gens[-2]) %>>gen <%= n %><%= ', pinned' if @repository.retention.pinned?(n) %></option><% end %></select>
          <label class="lbl" for="diff-to">to</label>
          <select id="diff-to" name="to" class="filter auto"><% gens.each do |n| %><option value="<%= n %>"<%= ' selected'.html_safe if n == (@diff&.to || gens[-1]) %>>gen <%= n %><%= ', pinned' if @repository.retention.pinned?(n) %></option><% end %></select>
          <button class="btn" type="submit">Diff</button>
        </form>
      </section>
    <% end %>
    <%= render 'woods_map/shared/status', items: ['history', 'HEAD-reachable', "#{h.days}d", "gen #{@repository.generation_number}", (h.table? ? 'commit table' : 'metadata.git, 5 per unit')], keys: [[%w[/], 'search'], [%w[e], 'expand all']] %>
  </div>
</div>
