<%# The export tools of a diagram (mermaid-diagram-types.md, constraint 3;
    D-25): ⎘ copies the Mermaid text already in the page, ⤓ .mmd links to the
    same text served as text/plain from a stable URL, for people and for
    agents that should not scrape HTML, and ⎘ copy for PR comment copies the
    text as a GitHub pull-request comment (woods-map#76): a ```mermaid block
    and one line linking this view and its .mmd URL. A text a comment cannot
    hold says so instead of offering a broken paste; a diagram over its
    drawing budget offers no comment. A type newer than GitHub's Mermaid says
    so. Locals: text (String, the Mermaid text), name (String, what the
    diagram shows, for the file name), url (String or nil, the .mmd route),
    key (String or nil: "y" when this is the copy the page's status bar
    names), refused (Boolean: the panel draws nothing over its budget).
    data-mermaid-name and data-mermaid-href let the Share menu list the page's
    diagrams with their absolute .mmd URLs and comments (D-25). Text over
    MermaidExport::INLINE_BYTES is copied from the .mmd route instead, and
    not at all when the diagram is over its budget (its .mmd answers 422). %>
<% href = local_assigns[:url] && public_url_for(local_assigns[:url]) %>
<% oversized = WoodsMap::MermaidExport.oversized?(text) %>
<% linked = oversized && local_assigns[:url].present? %>
<% unless oversized && local_assigns[:refused] %><%= tag.button('⎘ copy Mermaid', class: 'tool', type: 'button', data: { controller: 'copy', copy_text_value: (linked ? nil : text), copy_url_value: (linked ? url : nil), action: 'copy#copy', needs_js: true, key: local_assigns[:key], mermaid_name: name, mermaid_href: href }.compact) %><% end %>
<% if local_assigns[:url] %><%= link_to('⤓ .mmd', url, class: 'tool', rel: 'alternate', type: 'text/plain', download: WoodsMap::MermaidExport.filename(name), data: { mermaid_url: true }) %><% end %>
<% unless local_assigns[:refused] %>
  <% comment = pr_comment(text, name: name, url: local_assigns[:url]) %>
  <% if comment.body %><%= tag.button('⎘ copy for PR comment', class: 'tool', type: 'button', aria: { label: "copy for PR comment: #{name} as a GitHub pull-request comment, with a link to this view" }, data: { controller: 'copy', copy_text_value: comment.body, action: 'copy#copy', needs_js: true, pr_comment: true, mermaid_name: name, mermaid_href: href }.compact) %><% else %><%= tag.span(comment.short_refusal, class: 'lyr', data: { pr_comment_refusal: comment.refusal, mermaid_name: name, mermaid_href: href }.compact) %><% end %>
<% end %>
<% if WoodsMap::MermaidExport.newer_than_github?(text) %><span class="lyr">may not render on GitHub</span><% end %>
