<%# The impact page in range mode (W-12, D-1, D-25): Woods' schema 1 report
    rendered as tabs, Overview first. Without an available report, the
    selectors and the reason. The page renders evidence; it computes none. %>
<% rr = @range_report %>
<% if rr %>
  <% title = "gen #{rr.from_generation} → gen #{rr.to_generation}" %>
  <% content_for :title, "#{title} · Impact · Woods Map" %>
  <% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
  <% base = @saved_id ? ->(**p) { woods_map.saved_impact_path(id: @saved_id, **p) } : ->(**p) { woods_map.impact_path(from: @range.first, to: @range.last, **p) } %>
  <% range_url = ->(**changes) { base.call(**{ focus: params[:focus].presence, lens: (@lens == 'overview' ? nil : @lens) }.merge(changes).compact) } %>
  <% controls = safe_join([render('woods_map/shared/share'), tag.button('⎘ copy focus URL', class: 'btn primary', type: 'button', data: { controller: 'copy', copy_text_value: focus_url, action: 'copy#copy', key: 'y' }, 'data-needs-js': '')], ' ') %>
  <% tabs = WoodsMap::RangeReport::LENSES.map { |lens| { label: lens.capitalize, count: rr.count(lens), href: range_url.call(lens: (lens == 'overview' ? nil : lens)), current: lens == @lens } } %>
  <% subtitle = [rr.sha('from'), rr.sha('to')].all? ? "#{rr.sha('from')} → #{rr.sha('to')}" : 'retained generation evidence' %>
  <%= render 'woods_map/impact/frame', title: title, subtitle: subtitle, crumb: (@saved_id ? "report #{@saved_id[0, 7]}" : 'range'), controls: controls, tabs: tabs %>
  <% if @lens == 'graph' %>
    <%= render 'woods_map/impact/range/graph', rr: rr, range_url: range_url %>
  <% else %>
    <div class="body" data-controller="trail" data-trail-title-value="<%= title %>">
      <%= render 'woods_map/components/rail', heading: @lens.capitalize, groups: [
            { label: 'changed', count: rr.changed.size, items: rr.changed.first(10).map { |c| { key: (c['status'] == 'removed' ? '−' : (c['status'] == 'added' ? '+' : 'M')), text: impact_identity(c, rr, generation: rr.generation_of_change(c), since: rr.from_generation), own: c['type'].to_s.tr('_', ' '), current: rr.focused?(c) } } + (rr.changed.size > 10 ? [{ key: '·', text: "+#{rr.changed.size - 10} more" }] : []) },
            { label: 'affected', count: rr.affected.size, items: rr.affected.first(8).map { |a| { key: a['distance'] || '·', text: impact_identity(a, rr), own: a['type'].to_s.tr('_', ' ') } } + (rr.affected.size > 8 ? [{ key: '·', text: "+#{rr.affected.size - 8} more" }] : []) },
            { label: 'limits', count: 3, items: [
              { key: '·', text: 'which lines changed', own: layer_chip('woods#802') },
              { key: '·', text: "flows: #{rr.coverage['flows'] || 'not recorded'}", own: layer_chip('W-13 membership') },
              retention_limit(@repository.retention, rr.from_generation)
            ] }
          ].reject { |g| g[:items].empty? } %>
      <div class="main">
        <%= render "woods_map/impact/range/#{@lens}", rr: rr, range_url: range_url %>
        <%= render 'woods_map/shared/status', items: ["computed by Woods from gen #{rr.from_generation} and gen #{rr.to_generation}", (rr.complete? ? 'declared complete' : 'incomplete report'), "map on gen #{@repository.generation_number}"], keys: [[%w[y], 'copy URL'], [%w[/], 'search']] %>
      </div>
    </div>
  <% end %>
<% else %>
  <% content_for :title, 'Impact range · Woods Map' %>
  <% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
  <%= render 'woods_map/impact/frame', title: 'Impact range', subtitle: 'retained generation evidence', crumb: (@saved_id ? 'saved report' : 'range'), controls: render('woods_map/shared/share') %>
  <div class="body">
    <div class="main inset">
      <%= render 'woods_map/impact/range/selectors' %>
      <% if @report %>
        <%= render 'woods_map/components/empty_state', title: (@saved_id ? 'Saved report unavailable' : 'Range evidence unavailable'), text: @report.message %>
      <% end %>
    </div>
  </div>
<% end %>
