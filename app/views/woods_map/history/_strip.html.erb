<%# The commit strip (B6-History): bars per week (per day in a short window),
    the last four weeks hot, a dashed mark per retained generation. Drawn as
    an SVG in viewBox units; colours come from map.css. Locals: strip
    (CommitStrip), bar_url (callable Date => URL, or nil for plain bars),
    selected (Date or nil), label (String, the chart's accessible name). %>
<% bar_url = local_assigns[:bar_url] %>
<div class="strip">
  <svg class="strip-svg" viewBox="0 -4 <%= strip.width %> <%= WoodsMap::CommitStrip::HEIGHT + 6 %>" preserveAspectRatio="none" role="group" aria-label="<%= label %>">
    <title><%= label %></title>
    <% strip.marks.each do |mark| %><line class="gm" x1="<%= mark.x %>" x2="<%= mark.x %>" y1="-4" y2="<%= WoodsMap::CommitStrip::HEIGHT %>"><title>generation <%= mark.number %> extracted</title></line><% end %>
    <% strip.buckets.each do |bucket| %>
      <% classes = ['bar', (bucket.recent ? 'recent' : nil), (bucket.count.zero? ? 'zero' : nil), (local_assigns[:selected] == bucket.first ? 'sel' : nil)].compact.join(' ') %>
      <% height = bucket.count.zero? ? 1 : bucket.height %>
      <% rect = tag.rect(class: classes, x: bucket.x, y: WoodsMap::CommitStrip::HEIGHT - height, width: WoodsMap::CommitStrip::BAR, height: height) %>
      <% if bar_url && bucket.count.positive? %>
        <a href="<%= bar_url.call(bucket.first) %>" aria-label="<%= bucket.label(strip.step) %>"><title><%= bucket.label(strip.step) %></title><%= rect %></a>
      <% else %>
        <g><title><%= bucket.label(strip.step) %></title><%= rect %></g>
      <% end %>
    <% end %>
  </svg>
  <svg class="strip-axis" width="100%" height="14" aria-hidden="true" focusable="false"><% last = [strip.bucket_count - 1, 1].max %><% strip.ticks.each do |index, text| %><text x="<%= (100.0 * index / last).round(2) %>%" y="11" text-anchor="<%= index.zero? ? 'start' : (index == last ? 'end' : 'middle') %>"><%= text %></text><% end %></svg>
</div>
