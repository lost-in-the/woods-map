<%# The sheet behind ☰ below 960 (C3-Navigation): files first, this page's
    sections below. It holds the file tree and borrows the page's nav.rail
    while open. Locals: tree (FileTree or nil), current_path (String or nil). %>
<div class="sheet-overlay" hidden data-sheet-target="overlay" data-action="click->sheet#outside">
  <div class="sheet" role="dialog" aria-modal="true" aria-label="Files and sections">
    <div class="sh"><button class="tool" type="button" aria-label="Close" data-action="sheet#close" data-sheet-target="close">✕</button><span class="eyebrow">files</span><span class="eyebrow" style="margin-left:var(--s5);color:var(--dim)">on this page</span></div>
    <div data-sheet-target="body">
      <% if local_assigns[:tree] %>
        <%= render 'woods_map/components/tree', total: "#{tree.unit_count} units", rows: tree.rows.map { |row| { kind: row.kind, name: row.name, level: row.level, path: row.path, count: row.count, open: row.level < 2, current: row.path == local_assigns[:current_path], unindexed: row.kind == :file && row.identifier.nil?, href: (row.identifier && row.type ? woods_map.unit_path(type: row.type, identifier: row.identifier) : nil), chips: (row.units.to_i > 1 ? tag.span(" #{row.units}", class: 'ct') : nil) } } %>
      <% end %>
    </div>
  </div>
</div>
