<%# C4 · Diagrams: the panel, the legend, the icon rail, drawn by Pele (D-21). The specimen text is the board's seq-post-create fixture without its Mermaid-era colours. %>
<% specimen = <<~MERMAID.chomp
  sequenceDiagram
    autonumber
    participant B as Browser
    participant C as PostsController#create
    participant P as Post
    participant J as NotifySubscribersJob
    participant M as SubscriptionMailer
    B->>C: POST /posts
    C->>C: before_action :authenticate_user!
    C->>P: Post.new(post_params).save
    P->>P: before_validation :normalize_title
    Note over P: transaction
    P->>P: after_save :touch_user
    P-)J: after_commit → perform_later(post.id)
    P-->>C: true
    C-->>B: 302 → /posts/:id
    J->>M: notify(post, subscriber)
    loop each subscription (find_each)
      M-)M: deliver_later
    end
MERMAID
%>
<section class="sec" id="diagrams"><header><h2 class="t2">C4 · Diagrams</h2><span class="n">every diagram wears the same tokens: a header band, a body that scrolls sideways at native size, a legend that decodes every glyph</span></header>
  <div class="row wide">
    <div class="box"><div class="lbl">sequence panel with its legend</div>
      <%= render 'woods_map/components/diagram', title: 'Post.create', facts: ['sequence', '6 participants', '12 messages'], tools: safe_join([tag.span(safe_join([tag.button('↕', class: 'tgl lane on', type: 'button', title: 'sequence', 'aria-pressed': 'true'), tag.button('⤵', class: 'tgl lane', type: 'button', title: 'flowchart'), tag.button('≡', class: 'tgl lane', type: 'button', title: 'lanes')]), class: 'irail lanes')]), mermaid: specimen, name: 'Post create specimen', label: 'Specimen: the sequence of POST /posts, from the browser through the controller and model to the job and mailer', legend: [[tag.span('→', class: 'ar'), 'call, same process'], [tag.span('⇢', class: 'ar'), 'return'], [tag.span('⇒', class: 'ar'), 'async hop, a new process'], [tag.i(class: 'sw changed'), 'changed in this range'], [chip(:risk), 'risk']], provenance: ['flow_index.json', 'gen 42'] %></div>
    <div class="box"><div class="lbl">rules</div><%= render 'woods_map/components/detail', rows: [['header band', 'panel background, Inter title, mono facts separated by gap, tools right; no rule under the band'], ['body', 'page background, 13px padding, scrolls sideways with a cliff; the SVG keeps its natural width and is never scaled down'], ['labels', 'edge and relationship labels sit on an opaque page-background box'], ['classes', '.changed = sun stroke + 10% tint, .risk = beak stroke, .focus = purple+ stroke; type tints are the low-saturation fills in the legend'], ['legend', 'under a rule, 12px Inter, every glyph and tint decoded, comma phrasing; it is not a hint'], ['text', 'Fira Code 12.5px everywhere, set by the renderer'], ['icon rail', '↕ sequence, ⤵ flowchart, ≡ lanes, with tooltips; pressed state inverts']] %></div>
  </div>
</section>
