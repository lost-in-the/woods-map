<% content_for :title, "#{@page.identifier} · Graph · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% n = @neighbourhood %>
<%= render 'woods_map/units/frame', page: @page, tab: 'graph', definition: @definition %>
<% since = current_since&.available? ? { since: current_since.selector } : {} %>
<%= render 'woods_map/graphs/explorer', identifier: @page.identifier, type: @page.type, n: n,
      blast: current_since&.graph_blast, emphasis: (current_since&.available? ? :range : nil), hidden: since,
      flows: @flows, flow: @flow, timeline: @timeline,
      link: ->(**opts) { woods_map.unit_graph_path(type: @page.type, identifier: @page.identifier, **opts.except(:blast).merge(since).compact) },
      unit_url: woods_map.unit_graph_path(type: '__type__', identifier: '__identifier__', depth: n.depth, direction: n.direction, **since),
      mermaid_url: woods_map.unit_graph_mmd_path(type: @page.type, identifier: @page.identifier, direction: n.direction, depth: n.depth, types: params[:types].presence, via: params[:via].presence),
      rail_extra: tag.div('full screen', class: 'grp') + tag.ol(tag.li(safe_join([tag.span('·', class: 'k'), tag.span(safe_join([link_to('full-screen graph', woods_map.graph_path(centre: @page.identifier, type: @page.type, depth: n.depth, direction: n.direction)), ' ', tag.span('blast radius tint, more room', class: 'own')]))]))) %>
