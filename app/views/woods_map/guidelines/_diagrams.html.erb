<%# C4 · Diagrams: the panel, the legend, the icon rail. The renderer itself is M3 (woods-map#25). %>
<section class="sec" id="diagrams"><header><h2 class="t2">C4 · Diagrams</h2><span class="n">every diagram wears the same tokens: a header band, a body that scrolls sideways at native size, a legend that decodes every glyph</span></header>
  <div class="row wide">
    <div class="box"><div class="lbl">sequence panel with its legend</div>
      <%= render 'woods_map/components/diagram', title: 'Post.create', facts: ['sequence', '6 participants', '12 messages'], tools: safe_join([tag.span(safe_join([tag.button('↕', class: 'tgl', type: 'button', title: 'sequence', 'aria-pressed': 'true', style: 'background:var(--bright);color:var(--bg);font-size:12px'), tag.button('⤵', class: 'tgl', type: 'button', title: 'flowchart', style: 'font-size:12px'), tag.button('≡', class: 'tgl', type: 'button', title: 'lanes', style: 'font-size:12px')]), class: 'irail', style: 'display:inline-flex;gap:var(--s2)'), tag.button('⎘ copy Mermaid', class: 'tool', type: 'button')]), body: tag.div('rendered SVG lands here with M3; the panel, band and legend are the component', style: 'height:180px;min-width:720px;border:1px dashed var(--rule2);border-radius:var(--r-ctl);display:flex;align-items:center;justify-content:center;color:var(--dim);font-family:var(--ff-ui);font-size:var(--fs-12)'), legend: [[tag.span('→', class: 'ar'), 'call, same process'], [tag.span('⇢', class: 'ar'), 'return'], [tag.span('⇒', class: 'ar'), 'async hop, a new process'], [tag.i(class: 'sw', style: 'background:var(--mod-tint);border-color:var(--mod)'), 'changed in this range'], [chip(:risk), 'risk']], provenance: ['flow_index.json', 'gen 42'] %></div>
    <div class="box"><div class="lbl">rules</div><%= render 'woods_map/components/detail', rows: [['header band', 'panel background, Inter title, mono facts separated by gap, tools right; no rule under the band'], ['body', 'page background, 13px padding, scrolls sideways with a cliff; the SVG keeps its natural width and is never scaled down'], ['labels', 'edge and relationship labels sit on an opaque page-background box'], ['classes', '.changed = sun stroke + 10% tint, .risk = beak stroke, .focus = purple+ stroke; type tints are the low-saturation fills in the legend'], ['legend', 'under a rule, 12px Inter, every glyph and tint decoded, comma phrasing; it is not a hint'], ['text', 'Fira Code 12.5px everywhere, set by the renderer'], ['icon rail', '↕ sequence, ⤵ flowchart, ≡ lanes, with tooltips; pressed state inverts']] %></div>
  </div>
</section>
