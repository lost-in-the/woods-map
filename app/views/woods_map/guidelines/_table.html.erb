<%# C2 · Table: anatomy, detail blocks, numbered steps, the expandable row, four widths, light and CVD. %>
<% commit_columns = [{ label: 'when', width: '58px', cell_class: 'nw' }, { label: 'sha', width: '84px', cell_class: 'nw mut' }, { label: 'author', width: '120px' }, { label: 'message', cell_class: 'id' }, { label: 'files', width: '58px', cell_class: 'num' }, { label: 'gen', width: '52px', cell_class: 'num' }, { label: 'facets moved', width: '150px' }]
   now = Time.utc(2026, 10, 16, 14, 2, 0)
   commit = ->(ago, sha, author, message, files, gen, facets) { { cells: [date_abbr(now - ago, now: now), sha, who(author), message, files, link_to(gen, '#'), facets] } }
   commits = [
     commit.call(3 * 86_400, '361468d', 'Leah Armstrong', 'Touch the author when a post is saved', '2', '42', 'behaviour, tests'),
     commit.call(9 * 86_400, '2e8d0b4', 'Leah Armstrong', safe_join(['Notify subscribers after commit ', chip(:risk, 'no retry_on')]), '3', '41', 'behaviour, dependency edges'),
     commit.call(12 * 86_400, 'c13f7a8', 'Sam Okafor-Whitfield', 'Post state machine', '4', '40', 'behaviour, schema'),
     commit.call(35 * 86_400, '4b7e9d2', 'dependabot[bot]', 'Extract Countable', '3', '38', empty_value(applicable: false)),
     commit.call(49 * 86_400, '9f2a1c0', 'Leah Armstrong', 'Add slug to posts', '3', '36', 'schema, behaviour')
   ]
   detail = render('woods_map/components/detail', rows: [
     ['description', tag.span("Authors expect their profile's updated_at to move when they publish, so the feed sorts them first. after_save :touch_user does that inside the same transaction.", class: 'desc')],
     ['files', safe_join(['app/models/post.rb ', tag.span('+6 −1', class: 'dim'), tag.br, 'spec/models/post_spec.rb ', tag.span('+14', class: 'dim')])],
     ['hunks', link_to('open in the code view', '#')], ['co-changed with', link_to('PostsController', '#')]
   ])
   with_details = commits.first(3).each_with_index.map { |row, i| i == 1 ? row.merge(detail: detail) : row }
   steps = [
     { n: 1, depth: 0, text: safe_join(['POST /posts → ', link_to('PostsController#create', '#')]) },
     { n: 2, depth: 1, arrow: :call, text: safe_join([link_to('Post', '#'), '.save(post_params)']) },
     { n: 3, depth: 2, arrow: :call, text: 'INSERT INTO posts', mech: 'transaction' },
     { n: 4, depth: 2, arrow: :call, text: 'after_commit', mech: 'perform_later(id) to the default queue' },
     { n: 5, depth: 1, arrow: :return, text: '302 → post_path', mech: 'response' },
     { boundary: '⇒ async hop, new process: queue worker' },
     { n: 6, depth: 0, arrow: :async, proc: true, text: safe_join([chip(:modified), link_to('NotifySubscribersJob#perform', '#')]), mech: 'from the queue, no retry_on' },
     { n: 7, depth: 0, arrow: :async, text: safe_join([chip(:modified), link_to('MailingListMailer#new_post', '#')]), mech: 'deliver_later, per follower' },
     { n: 8, depth: 1, arrow: :call, text: safe_join([chip(:modified), link_to('new_post.html.erb', '#')]), mech: 'render' },
     { n: 9, depth: 2, arrow: :call, text: link_to('User#preferences', '#'), mech: 'nil for 3 fixtures' }
   ]
   entry = safe_join([link_to('POST /posts', '#'), tag.br, tag.span('PostsController#create', class: 'mut')])
   steps_table = render('woods_map/components/steps', steps: steps)
   flow_columns = [{ label: 'entry point', width: '190px', cell_class: 'lead' }, { label: 'steps, numbered like the diagram', cell_class: 'nopad' }, { label: 'changed', width: '72px', cell_class: 'num' }, { label: 'layer', width: '120px' }]
   flow_row = ->(open, checked) { { cells: [entry, steps_table, '3 of 6', tag.span(safe_join(['precomputed', tag.br, 'gen 42']), class: 'mut')], checkbox: 'Include in review set', open: open, checked: checked, detail: render('woods_map/components/diagram', title: 'POST /posts', facts: ['sequence', '9 messages', 'numbers match the step list'], tools: safe_join([link_to('share', '#'), ' ', tag.button('⎘ copy Mermaid', class: 'tool', type: 'button')]), body: tag.div('sequence diagram, rendered on expand (see C4 Diagrams)', style: 'height:160px;border:1px dashed var(--rule2);border-radius:var(--r-ctl);display:flex;align-items:center;justify-content:center;color:var(--dim);font-family:var(--ff-ui);font-size:var(--fs-12)'), legend: [[tag.span('→', class: 'ar'), 'call, same process'], [tag.span('⇢', class: 'ar'), 'return'], [tag.span('⇒', class: 'ar'), 'async hop, a new process'], [chip(:modified), 'modified in gen 42'], [chip(:risk), 'risk, see Risks']]) } } %>
<section class="sec" id="table"><header><h2 class="t2">C2 · Table</h2><span class="n">frame, head, cells, striping, column rules, empty values, links and chips, detail blocks, numbered steps, the expandable row, four widths, themes</span></header>
  <h3 class="t3" id="table-anatomy" style="margin-bottom:var(--s3)">Anatomy</h3>
  <%= render 'woods_map/components/table', columns: commit_columns, rows: commits, min_width: '760px', label: 'Commits', caption: 'latest 5 of 23, HEAD-reachable. Facets moved are computed by comparing the unit JSON of consecutive generations.' %>
  <div class="spec-note"><b>frame</b> 1px rule2 around the table; cells and column rules are 1px rule; thead sits on panel. <b>head</b> Inter 11px uppercase slate, 500; a th is a label, not a heading. <b>cells</b> Fira Code 13px smoke, 8 × 13 padding, top-aligned; identifiers nowrap, prose wraps at words. <b>champion column</b> the thing you scan by is snow 500. <b>people</b> the git author as recorded, never wrapped; over 16 characters it truncates with the full name on hover. <b>numbers</b> right-aligned, tabular figures. <b>links</b> cobalt+, underline on hover. <b>chips</b> <%= chip(:modified) %> modified, <%= chip(:hot) %> churn, <%= chip(:risk) %> risk; each is a word or glyph, never a colour alone. <b>empty</b> — for not applicable, none for known-empty, both gray.</div>
  <h3 class="t3" style="margin:var(--s5) 0 var(--s3)" id="table-detail">Detail blocks</h3>
  <div class="row">
    <div class="box" data-controller="rows"><div class="lbl">closed, the default <button class="tool" type="button" data-action="rows#expandAll" data-needs-js style="margin-left:var(--s4)">expand all</button> <button class="tool" type="button" data-action="rows#collapseAll" data-needs-js>collapse all</button></div>
      <%= render 'woods_map/components/table', columns: commit_columns, rows: with_details, grouped: true, min_width: '760px', label: 'Commits with details', caption: 'latest 3 of 23, HEAD-reachable.' %></div>
    <div class="box" data-controller="rows"><div class="lbl">one open; the block is hairline rows under the row's own rule</div>
      <%= render 'woods_map/components/table', columns: commit_columns, rows: with_details.each_with_index.map { |row, i| i == 1 ? row.merge(open: true) : row }, grouped: true, min_width: '760px', label: 'Commits, one open' %></div>
  </div>
  <div class="spec-note"><b>+ only on rows that have details</b>, bottom-aligned in its cell; other rows keep the empty column so cells align. The block is a label column (slate) and values as hairline rows; no left bar. Every row keeps its bottom rule, open or closed. "expand all" and "collapse all" live in the section header as text tools, never inside the table. Keys: j / k move rows, Enter toggles, Space checks, e expands all, E collapses all. Without JavaScript every block is open.</div>
  <h3 class="t3" style="margin:var(--s5) 0 var(--s3)" id="table-steps">Numbered steps</h3>
  <div class="row wide">
    <div class="box"><div class="lbl">inside a cell, edge to edge</div>
      <%= render 'woods_map/components/table', columns: [{ label: 'entry point', width: '200px' }, { label: 'steps, numbered like the diagram; indent = call depth', cell_class: 'nopad' }], rows: [{ cells: [entry, steps_table] }], label: 'Steps' %></div>
    <div class="box"><div class="lbl">rules</div>
      <%= render 'woods_map/components/detail', rows: [['gutter', 'a plain cell with a column rule, slate numbers, right-aligned'], ['process', 'a 2px rule2 line with a label row before the first step of the new process; numbers stay flat (1–9) to match the diagram'], ['indent', '18px per call depth; the entry step has no glyph'], ['mechanism', 'gray second line, comma phrasing, no bullets'], ['glyphs', '→ call, ⇢ return, ⇒ async hop; the same three in the legend']] %></div>
  </div>
  <h3 class="t3" style="margin:var(--s5) 0 var(--s3)" id="table-expandable">Expandable row</h3>
  <div class="row" style="grid-template-columns:minmax(0,1fr)">
    <div class="box" data-controller="rows"><div class="lbl">closed</div><%= render 'woods_map/components/table', columns: flow_columns, rows: [flow_row.call(false, false)], grouped: true, label: 'Flows, closed' %></div>
    <div class="box" data-controller="rows"><div class="lbl">open: body flush in the row, header band on panel, legend under a rule</div><%= render 'woods_map/components/table', columns: flow_columns, rows: [flow_row.call(true, false)], grouped: true, label: 'Flows, open' %></div>
    <div class="box" data-controller="rows"><div class="lbl">checked and open: 3px purple+ bar continues through the body; 8% tint on the toggle cell only</div><%= render 'woods_map/components/table', columns: flow_columns, rows: [flow_row.call(true, true)], grouped: true, label: 'Flows, checked' %></div>
  </div>
  <h3 class="t3" style="margin:var(--s5) 0 var(--s3)" id="table-widths">Four widths</h3>
  <div class="row phone">
    <div class="box"><div class="lbl">split, 960: scrolls sideways, first column sticky</div><div class="wm narrow" style="width:960px;max-width:100%"><div style="padding:var(--s4)"><%= render 'woods_map/components/table', columns: commit_columns, rows: commits, sticky: true, min_width: '760px', label: 'Commits at 960' %></div></div>
      <div class="lbl" style="margin-top:var(--s5)">narrow, 640: still a table, padding steps down one notch</div><div class="wm narrow" style="width:640px;max-width:100%"><div style="padding:var(--s4)"><%= render 'woods_map/components/table', columns: commit_columns, rows: commits.first(3), min_width: '760px', label: 'Commits at 640' %></div></div></div>
    <div class="box"><div class="lbl">phone, 390: the card list; the champion field is the card title</div><div class="wm narrow" style="width:390px;max-width:100%"><div class="acc"><span>▾</span>Commits<span class="cnt">latest 3 of 23</span></div><div style="padding:var(--s3)"><%= render 'woods_map/components/table', columns: commit_columns, rows: commits.first(3), cards: true, label: 'Commits at 390' %></div><div class="acc"><span>▸</span>Co-changes<span class="cnt">4</span></div></div></div>
  </div>
  <h3 class="t3" style="margin:var(--s5) 0 var(--s3)" id="table-themes">Light and colour-vision themes</h3>
  <div class="row">
    <div class="box"><div class="lbl">light: true pigeon colours</div><div class="wm narrow" data-theme="light" style="padding:var(--s4)" data-controller="rows"><%= render 'woods_map/components/table', columns: commit_columns, rows: with_details.each_with_index.map { |row, i| i == 1 ? row.merge(open: true) : row }, grouped: true, min_width: '640px', label: 'Commits, light' %></div></div>
    <div class="box"><div class="lbl">dark, colour-vision: modified borrows the link hue, links always underlined</div><div class="wm narrow" data-cvd="on" style="padding:var(--s4)" data-controller="rows"><%= render 'woods_map/components/table', columns: commit_columns, rows: with_details.each_with_index.map { |row, i| i == 1 ? row.merge(open: true) : row }, grouped: true, min_width: '640px', label: 'Commits, colour-vision' %><div style="margin-top:var(--s3)"><%= chip(:modified) %> modified <%= chip(:hot) %> <%= chip(:risk) %> risk <%= link_to('a link', '#') %></div></div></div>
  </div>
</section>
