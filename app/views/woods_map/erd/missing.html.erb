<% content_for :title, 'Woods Map · no such chunk' %>
<%= render 'woods_map/components/empty_state', heading: :h1, title: "No chunk #{params[:chunk]} by #{@by}", text: tag.p(safe_join(["Gen #{@repository.generation_number} has #{@erd.chunks(@by).size} #{'chunk'.pluralize(@erd.chunks(@by).size)} when tables are chunked by #{@by}, each at most #{WoodsMap::SchemaView::TABLE_BUDGET} tables. Chunk numbers change when tables are added or removed."])), cap: safe_join([link_to('the first chunk', woods_map.erd_path(by: (@by == WoodsMap::Erd::GROUPINGS.first ? nil : @by))), ' · ', link_to('status', woods_map.root_path)]) %>
