erDiagram
  accTitle: Post schema, one hop
  accDescr: Post with its associations and the join model Tagging; Attachment is polymorphic.
  users {
    bigint id PK
    string email UK
    string name
  }
  posts {
    bigint id PK
    bigint user_id FK
    string title
    string state
    datetime published_at
  }
  comments {
    bigint id PK
    bigint post_id FK
    bigint user_id FK
    text body
  }
  tags {
    bigint id PK
    string name UK
  }
  taggings {
    bigint id PK
    bigint post_id FK
    bigint tag_id FK
  }
  attachments {
    bigint id PK
    string attachable_type
    bigint attachable_id
    string blob_key
  }
  subscriptions {
    bigint id PK
    bigint user_id FK
    bigint post_id FK
  }
  users ||--o{ posts : "has_many :posts"
  users ||--o{ comments : "has_many :comments"
  posts ||--o{ comments : "has_many :comments, dependent: :destroy"
  posts ||--o{ taggings : "has_many :taggings"
  tags ||--o{ taggings : "has_many :taggings"
  posts }o..o{ tags : "has_many :tags, through: :taggings"
  posts ||..o{ attachments : "has_many :attachments, as: :attachable"
  comments ||..o{ attachments : "has_many :attachments, as: :attachable"
  users ||--o{ subscriptions : "has_many :subscriptions"
  posts ||--o{ subscriptions : "has_many :subscriptions"
