<%# Under a finished answer (B8-Guide): pin its units to the Trail board it
    was asked on, open them as an investigation (M6), copy its Markdown, or
    draft an issue from it. An issue draft offers its text to copy and says
    that the map posts nothing. The guide controller builds the same row for
    an answer that just streamed. Locals: turn (Hash). %>
<div class="answer-tools">
  <% if turn['kind'] == 'issue' %>
    <button class="tool" type="button" data-controller="copy" data-copy-text-value="<%= turn['answer'] %>" data-action="copy#copy">⎘ copy issue</button>
    <span class="cap">Paste it into your tracker; the map posts nothing.</span>
  <% else %>
    <% trail = guide_trail_links(turn) %>
    <% if trail['pin'] %><a class="tool" href="<%= trail['pin'] %>" aria-label="Pin the units this answer cites to this Trail board">pin</a><% end %>
    <% if trail['investigation'] %><a class="tool" href="<%= trail['investigation'] %>" aria-label="Open the units this answer cites as a Trail investigation">open as investigation</a><% end %>
    <button class="tool" type="button" data-controller="copy" data-copy-text-value="<%= turn['answer'] %>" data-action="copy#copy">⎘ copy</button>
    <button class="tool" type="button" data-action="guide#draftIssue" data-guide-source-param="<%= turn['id'] %>">draft an issue</button>
  <% end %>
</div>
