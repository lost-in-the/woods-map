<%# The code view (B8-Code): heat strip, line numbers, source, marginalia.
    Locals: code (CodeView), page (UnitPage), heat (PathHeat or nil: per-file
    heat from the commit table), concern_paths (Hash of concern name => its
    file, for the inlined blocks' heat). Without a commit table the strip
    takes the unit's change_frequency. With ?since= (E-8) the gutter marks
    the lines Woods' report records as changed (source_changes, woods#802)
    and where lines were removed; a note is marked M when its line changed
    or the metadata it reads moved. %>
<% path_heat = local_assigns[:heat] %>
<% concern_paths = local_assigns[:concern_paths] || {} %>
<% unit_heat = { 'hot' => 'h3', 'active' => 'h2', 'new' => 'h2' }.fetch(page.unit.dig('metadata', 'git', 'change_frequency').to_s, 'h1') %>
<% heat_for = Hash.new { |cache, concern| path = concern ? concern_paths[concern] : page.path; cache[concern] = path_heat && path ? [path_heat.level(path), path_heat.describe(path)] : [unit_heat, nil] } %>
<% marks = current_since&.line_marks(page.identifier, page.type) %>
<% since_gen = current_since&.from_generation %>
<% lens_name = code.lens == 'effective' ? 'Effective class' : 'As written' %>
<div class="cvwrap" role="region" aria-label="Source of <%= page.identifier %>, <%= lens_name.downcase %> lens" tabindex="0" data-controller="cliff">
<div class="cv codeview">
  <div class="hdr"><b><%= lens_name %></b><span><%= code.lens == 'effective' ? 'schema header and concern bodies from the index, the file\'s own line numbers' : 'the file as committed, from the index' %></span><span class="tools"><span><%= code.line_count %> lines</span><button class="tool" type="button" aria-haspopup="dialog" aria-controls="wm-settings" data-action="settings#open" data-needs-js>settings</button><% if page.path %><button class="tool" type="button" data-controller="copy" data-copy-text-value="<%= page.path %>:<%= code.definition_line || 1 %>" data-action="copy#copy" data-needs-js>⎘ path:line</button><% end %></span></div>
  <% code.rows.each do |row| %>
    <% if row.kind == :fold %>
      <div class="fold"><%= row.fold == :concern ? '▾ ' : '' %><%= row.html.html_safe %> <span class="lyr"><%= row.fold == :concern ? 'not in the file' : 'schema header, not in the file' %></span></div>
    <% else %>
      <% note = row.note %>
      <% changed = marks&.changed?(row.composite) %>
      <% removed = marks ? marks.removed_count(row.composite) : 0 %>
      <% moved = note && (changed || (note.area && current_since&.area_changed?(page.identifier, page.type, note.area))) %>
      <div class="row contents<%= ' row-chg' if changed || moved %><%= ' row-rm' if removed.positive? %>"<%= " id=\"L#{row.number}\"".html_safe if row.number %>>
        <% level, why = heat_for[row.concern] %>
        <div class="heat"><i class="<%= level %>"<%= " title=\"#{ERB::Util.html_escape(why)}\"".html_safe if why %>></i></div>
        <div class="ln<%= ' dim' if row.concern %>"<%= " title=\"#{removed} #{'line'.pluralize(removed)} removed after this line since gen #{since_gen}\"".html_safe if removed.positive? %>><%= row.label %><% if changed %><span class="sr-only">, changed since gen <%= since_gen %></span><% end %><% if removed.positive? %><span class="sr-only">, <%= removed %> <%= 'line'.pluralize(removed) %> removed after it since gen <%= since_gen %></span><% end %></div>
        <div class="src"><%= row.html.html_safe %></div>
        <div class="mg"<%= " title=\"#{ERB::Util.html_escape(note.text)}\"".html_safe if note %>><% if note %><% if moved %><%= chip(:modified) %><span class="sr-only"><%= changed ? 'its line changed' : "its #{note.area.to_s.tr('_', ' ')} metadata changed" %> since gen <%= since_gen %>: </span><% end %><b><%= note.text %></b><% if note.layer %> <span class="lyr"><%= note.layer %></span><% end %><% end %></div>
      </div>
    <% end %>
  <% end %>
</div>
</div>
