{"type":"model","identifier":"User","file_path":"app/models/user.rb","namespace":null,"source_code":"# == Schema Information\n#\n# Table: users\n#\n# Columns:\n#   id                        integer         NOT NULL PRIMARY KEY\n#   name                      string          \n#   email                     string          \n#   created_at                datetime        NOT NULL\n#   updated_at                datetime        NOT NULL\n#   password_digest           string          \n#   remember_digest           string          \n#   admin                     boolean         DEFAULT \"0\"\n#   activation_digest         string          \n#   activated                 boolean         DEFAULT \"0\"\n#   activated_at              datetime        \n#   reset_digest              string          \n#   reset_sent_at             datetime        \n#\n# Indexes:\n#   index_users_on_email: [email] (unique)\n#\n\nclass User < ApplicationRecord\n  has_many :microposts, dependent: :destroy\n  has_many :active_relationships, class_name:  \"Relationship\",\n                                  foreign_key: \"follower_id\",\n                                  dependent:   :destroy\n  has_many :passive_relationships, class_name:  \"Relationship\",\n                                   foreign_key: \"followed_id\",\n                                   dependent:   :destroy\n  has_many :following, through: :active_relationships,  source: :followed\n  has_many :followers, through: :passive_relationships, source: :follower\n  attr_accessor :remember_token, :activation_token, :reset_token\n  before_save   :downcase_email\n  before_create :create_activation_digest\n  validates :name,  presence: true, length: { maximum: 50 }\n  VALID_EMAIL_REGEX = /\\A[\\w+\\-.]+@[a-z\\d\\-.]+\\.[a-z]+\\z/i\n  validates :email, presence: true, length: { maximum: 255 },\n                    format: { with: VALID_EMAIL_REGEX },\n                    uniqueness: true\n  has_secure_password\n  validates :password, presence: true, length: { minimum: 6 }, allow_nil: true\n\n  # Returns the hash digest of the given string.\n  def User.digest(string)\n    cost = ActiveModel::SecurePassword.min_cost ? BCrypt::Engine::MIN_COST :\n                                                  BCrypt::Engine.cost\n    BCrypt::Password.create(string, cost: cost)\n  end\n\n  # Returns a random token.\n  def User.new_token\n    SecureRandom.urlsafe_base64\n  end\n\n  # Remembers a user in the database for use in persistent sessions.\n  def remember\n    self.remember_token = User.new_token\n    update_attribute(:remember_digest, User.digest(remember_token))\n    remember_digest\n  end\n\n  # Returns a session token to prevent session hijacking.\n  # We reuse the remember digest for convenience.\n  def session_token\n    remember_digest || remember\n  end\n\n  # Returns true if the given token matches the digest.\n  def authenticated?(attribute, token)\n    digest = send(\"#{attribute}_digest\")\n    return false if digest.nil?\n    BCrypt::Password.new(digest).is_password?(token)\n  end\n\n  # Forgets a user.\n  def forget\n    update_attribute(:remember_digest, nil)\n  end\n\n  # Activates an account.\n  def activate\n    update_attribute(:activated,    true)\n    update_attribute(:activated_at, Time.zone.now)\n  end\n\n  # Sends activation email.\n  def send_activation_email\n    UserMailer.account_activation(self).deliver_now\n  end\n\n  # Sets the password reset attributes.\n  def create_reset_digest\n    self.reset_token = User.new_token\n    update_attribute(:reset_digest,  User.digest(reset_token))\n    update_attribute(:reset_sent_at, Time.zone.now)\n  end\n\n  # Sends password reset email.\n  def send_password_reset_email\n    UserMailer.password_reset(self).deliver_now\n  end\n\n  # Returns true if a password reset has expired.\n  def password_reset_expired?\n    reset_sent_at < 2.hours.ago\n  end\n\n  # Returns a user's status feed.\n  def feed\n    following_ids = \"SELECT followed_id FROM relationships\n                     WHERE  follower_id = :user_id\"\n    Micropost.where(\"user_id IN (#{following_ids})\n                     OR user_id = :user_id\", user_id: id)\n             .includes(:user, image_attachment: :blob)\n  end\n\n  # Follows a user.\n  def follow(other_user)\n    following << other_user unless self == other_user\n  end\n\n  # Unfollows a user.\n  def unfollow(other_user)\n    following.delete(other_user)\n  end\n\n  # Returns true if the current user is following the other user.\n  def following?(other_user)\n    following.include?(other_user)\n  end\n\n  private\n\n    # Converts email to all lowercase.\n    def downcase_email\n      self.email = email.downcase\n    end\n\n    # Creates and assigns the activation token and digest.\n    def create_activation_digest\n      self.activation_token  = User.new_token\n      self.activation_digest = User.digest(activation_token)\n    end\nend\n","metadata":{"table_name":"users","primary_key":"id","database":"primary","associations":[{"name":"microposts","type":"has_many","target":"Micropost","options":{"dependent":"destroy"},"through":null,"through_db":null,"polymorphic":null,"foreign_key":"user_id","inverse_of":"user","from_db":"primary","to_db":"primary","disable_joins":false},{"name":"active_relationships","type":"has_many","target":"Relationship","options":{"dependent":"destroy","foreign_key":"follower_id","class_name":"Relationship"},"through":null,"through_db":null,"polymorphic":null,"foreign_key":"follower_id","inverse_of":null,"from_db":"primary","to_db":"primary","disable_joins":false},{"name":"passive_relationships","type":"has_many","target":"Relationship","options":{"dependent":"destroy","foreign_key":"followed_id","class_name":"Relationship"},"through":null,"through_db":null,"polymorphic":null,"foreign_key":"followed_id","inverse_of":null,"from_db":"primary","to_db":"primary","disable_joins":false},{"name":"following","type":"has_many","target":"User","options":{"through":"active_relationships","source":"followed"},"through":"active_relationships","through_db":"primary","polymorphic":null,"foreign_key":"followed_id","inverse_of":null,"from_db":"primary","to_db":"primary","disable_joins":false},{"name":"followers","type":"has_many","target":"User","options":{"through":"passive_relationships","source":"follower"},"through":"passive_relationships","through_db":"primary","polymorphic":null,"foreign_key":"follower_id","inverse_of":null,"from_db":"primary","to_db":"primary","disable_joins":false}],"polymorphic_interfaces":[],"validations":[{"attribute":"name","type":"presence","options":{},"conditions":{}},{"attribute":"name","type":"length","options":{"maximum":50},"conditions":{}},{"attribute":"email","type":"presence","options":{},"conditions":{}},{"attribute":"email","type":"length","options":{"maximum":255},"conditions":{}},{"attribute":"email","type":"format","options":{"with":"(?i-mx:\\A[\\w+\\-.]+@[a-z\\d\\-.]+\\.[a-z]+\\z)"},"conditions":{}},{"attribute":"email","type":"uniqueness","options":{},"conditions":{}},{"attribute":"password","type":"confirmation","options":{"case_sensitive":true,"allow_blank":true},"conditions":{}},{"attribute":"password","type":"presence","options":{"allow_nil":true},"conditions":{}},{"attribute":"password","type":"length","options":{"allow_nil":true,"minimum":6},"conditions":{}}],"callbacks":[{"type":"after_validation","filter":"_ensure_no_duplicate_errors","kind":"after","conditions":{},"side_effects":{"columns_written":[],"jobs_enqueued":[],"services_called":[],"mailers_triggered":[],"database_reads":[],"operations":[]}},{"type":"before_validation","filter":"normalize_changed_in_place_attributes","kind":"before","conditions":{},"side_effects":{"columns_written":[],"jobs_enqueued":[],"services_called":[],"mailers_triggered":[],"database_reads":[],"operations":[]}},{"type":"around_save","filter":"around_save_collection_association","kind":"around","conditions":{},"side_effects":{"columns_written":[],"jobs_enqueu