<% content_for :title, "#{@page.identifier} · Lifecycle · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% chains = @lifecycle.chains %>
<% steps = @lifecycle.steps(@event) %>
<% controls = safe_join([tag.span('entry', class: 'lbl'), tag.span(safe_join(WoodsMap::Lifecycle::EVENTS.map { |e| link_to(e, woods_map.unit_lifecycle_path(type: @page.type, identifier: @page.identifier, event: e), 'aria-current': (e == @event ? 'true' : nil)) }), class: 'seg', role: 'group', 'aria-label': 'entry')]) %>
<%= render 'woods_map/units/frame', page: @page, tab: 'lifecycle', controls: controls, definition: @definition %>
<div class="body" data-controller="trail" data-trail-title-value="<%= @page.identifier %>">
  <%= render 'woods_map/components/rail', heading: 'Lifecycle, as Rails runs it', groups: [
        { label: 'events', count: 'steps', items: chains.map { |event, list| { key: '·', text: link_to(event, woods_map.unit_lifecycle_path(type: @page.type, identifier: @page.identifier, event: event)), own: "#{list.size} #{'step'.pluralize(list.size)}#{list.any?(&:async?) ? ', async' : ''}", current: event == @event } } },
        { label: 'limits', count: 3, items: [{ key: '·', text: "#{@lifecycle.framework.size} framework #{'callback'.pluralize(@lifecycle.framework.size)} hidden", own: layer_chip('not defined here') }, { key: '·', text: 'proc callbacks are not analysed', own: layer_chip('CallbackAnalyzer') }, { key: '·', text: 'nothing here proves a path ran', own: layer_chip('static') }] }
      ] %>
  <div class="main">
    <% mermaid = (['sequenceDiagram', '  autonumber', "  participant App", "  participant #{@page.identifier}"] + steps.map { |s| "  #{s.async? ? "#{@page.identifier}-)#{s.side_effects['jobs_enqueued'].first || 'Mailer'}: #{s.filter}" : "App->>#{@page.identifier}: #{s.type} #{s.filter}"}" }).join("\n") %>
    <section class="sec">
      <%= render 'woods_map/components/diagram', title: 'Sequence', facts: ["#{@page.identifier} #{@event}", "#{steps.size} steps"], tools: tag.button('⎘ copy Mermaid', class: 'tool', type: 'button', data: { controller: 'copy', copy_text_value: mermaid, action: 'copy#copy' }), body: tag.pre(mermaid, class: 'cmd', style: 'margin:0;border:0;background:none', 'aria-label': 'Mermaid source', data: { controller: 'cliff' }), legend: [[tag.span('→', class: 'ar'), 'call, same process'], [tag.span('⇒', class: 'ar'), 'async hop: a new process; the transaction has ended'], ['', 'numbers match the steps below'], [tag.span('', class: 'lyr'), 'rendered diagrams land with M3 (woods-map#25)']], provenance: ['resolved chain', "gen #{@repository.generation_number}"] %>
    </section>
    <section class="sec" aria-labelledby="ladder">
      <header><h2 class="t2" id="ladder">Steps for <%= @event %> <%= count_tag("#{steps.size} steps, in the order Rails runs them") %><%= info_tip('Order is the resolved runtime chain, not file order. Side effects come from a regex analysis of the callback body; a proc callback is skipped.') %></h2></header>
      <% if steps.empty? %>
        <%= render 'woods_map/components/empty_state', title: "No callbacks on #{@event}", text: "#{@page.identifier} declares nothing that runs on #{@event}; validations and framework callbacks are not listed." %>
      <% else %>
        <% rows = [] %>
        <% steps.each do |s| %>
          <% rows << { cells: [s.n, s.type, s.filter, s.owner == @page.identifier ? @page.identifier : unit_link(s.owner, 'concern'), s.condition == '—' ? empty_value(applicable: false) : s.condition, s.effects.any? ? s.effects.join(', ') : empty_value, layer_chip(s.commit? ? 'after commit' : 'resolved chain')], classes: (s.commit? ? 'proc' : nil) } %>
          <% if s.async? %><% rows << { cells: ['', 'async hop', safe_join([tag.span('⇒', class: 'ar async'), ' ', Array(s.side_effects['jobs_enqueued']).map { |j| unit_link(j, 'job') }.then { |l| safe_join(l, ', ') }, ' runs in a new process, the transaction has ended']), '', '', '', layer_chip('job metadata')], classes: 'bnd' } %><% end %>
        <% end %>
        <%= render 'woods_map/components/table', label: "Steps for #{@event}", min_width: '900px', columns: [{ label: '#', width: '40px', cell_class: 'num' }, { label: 'kind', width: '140px', cell_class: 'nw' }, { label: 'step', cell_class: 'id' }, { label: 'defined in', width: '150px' }, { label: 'condition', width: '150px' }, { label: 'side effects', width: '220px' }, { label: 'layer', width: '130px' }], rows: rows %>
      <% end %>
    </section>
    <%= render 'woods_map/shared/status', items: ['sequence', 'numbers match the steps', "gen #{@repository.generation_number}"], keys: [[%w[c u d], 'event'], [%w[y], 'copy'], [%w[/], 'search']] %>
  </div>
</div>
