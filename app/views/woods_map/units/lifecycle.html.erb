<% content_for :title, "#{@page.identifier} · Lifecycle · Woods Map" %>
<% content_for :banner, render('woods_map/shared/freshness', freshness: @freshness) %>
<% chains = @lifecycle.chains %>
<% steps = @lifecycle.steps(@event) %>
<% here = ->(event: @event, view: @view) { woods_map.unit_lifecycle_path(type: @page.type, identifier: @page.identifier, event: event, view: (view == WoodsMap::Lifecycle::VIEWS.first ? nil : view), since: params[:since].presence) } %>
<% controls = safe_join([
     tag.span('entry', class: 'lbl'), tag.span(safe_join(WoodsMap::Lifecycle::EVENTS.map { |e| link_to(e, here.call(event: e), 'aria-current': (e == @event ? 'true' : nil)) }), class: 'seg', role: 'group', 'aria-label': 'entry'),
     tag.span('view', class: 'lbl'), tag.span(safe_join(@lifecycle.views.map { |v| link_to(v == 'dynamic' ? 'C4 dynamic' : v, here.call(view: v), 'aria-current': (v == @view ? 'true' : nil)) }), class: 'seg', role: 'group', 'aria-label': 'view')
   ], ' ') %>
<%= render 'woods_map/units/frame', page: @page, tab: 'lifecycle', controls: controls, definition: @definition %>
<% transitions = @state_machines.flat_map { |machine| machine.transitions.map { |t| [machine, t] } } %>
<div class="body" data-controller="trail" data-trail-title-value="<%= @page.identifier %>">
  <%= render 'woods_map/components/rail', heading: 'Lifecycle, as Rails runs it', groups: [
        { label: 'events', count: 'steps', items: chains.map { |event, list| { key: '·', text: link_to(event, here.call(event: event)), own: "#{list.size} #{'step'.pluralize(list.size)}#{list.any?(&:async?) ? ', async' : ''}", current: event == @event } } },
        ({ label: 'transitions', count: 'state machine', items: transitions.map { |_, t| { key: '·', text: t.event || 'transition', own: "#{t.from} → #{t.to}#{", guard #{t.guard}" if t.guard}" } } } if transitions.any?),
        { label: 'limits', count: 4, items: [{ key: '·', text: "#{@lifecycle.framework.size} framework #{'callback'.pluralize(@lifecycle.framework.size)} hidden", own: layer_chip('not defined here') }, { key: '·', text: 'proc callbacks are not analysed', own: layer_chip('CallbackAnalyzer') }, (@lifecycle.views.include?('dynamic') ? { key: '·', text: 'which process saves the model is not in the index', own: layer_chip('C4 dynamic') } : { key: '·', text: 'no C4-dynamic view: it needs container attribution', own: layer_chip('W-9') }), { key: '·', text: 'nothing here proves a path ran', own: layer_chip('static') }] }
      ].compact %>
  <div class="main">
    <% mermaid = @lifecycle.diagram(@view, @event) %>
    <% panel = {
         'sequence' => { title: 'Sequence', label: "Sequence of the #{@event} callbacks on #{@page.identifier}, numbered as in the steps below", unit: 'participants and messages',
                         legend: [[tag.span('→', class: 'ar'), 'call, same process'], [tag.span('⇒', class: 'ar'), 'async hop: a new process; the transaction has ended'], ['', 'numbers match the steps below']] },
         'flowchart' => { title: 'Flowchart', label: "Flowchart of the #{@event} callbacks on #{@page.identifier}, with each condition as a branch, numbered as in the steps below", unit: 'nodes',
                          legend: [['◇', 'a condition; its "no" branch skips the step'], [tag.span('⇢', class: 'ar'), 'async hop to a job or mailer, another process'], ['', 'numbers match the steps below']] },
         'dynamic' => { title: 'C4 dynamic', label: "C4 dynamic view of the #{@event} callbacks on #{@page.identifier}: steps grouped by the container they run in, the write in the database, and the jobs and mailers they hand work to", unit: 'nodes',
                        legend: [['▭', 'a container, with its technology'], [tag.span('→', class: 'ar'), 'call or write, numbered as the steps below'], [tag.span('⇢', class: 'ar'), 'async hop to another container'], ['', 'containers as on the Landscape page (W-9)']] },
         'lanes' => { title: 'Lanes', label: "Lanes of the #{@event} callbacks on #{@page.identifier}: validation, the transaction, after commit and another process", unit: 'nodes',
                      legend: [['', 'one lane per place a step runs'], [tag.span('⇢', class: 'ar'), 'async hop to a job or mailer, another process'], ['', 'numbers match the steps below']] }
       }.fetch(@view) %>
    <section class="sec">
      <%= render 'woods_map/components/diagram', title: panel[:title], facts: ["#{@page.identifier} #{@event}", "#{steps.size} steps"], name: "#{@page.identifier} lifecycle #{@event} #{@view}", mermaid_url: woods_map.unit_lifecycle_mmd_path(type: @page.type, identifier: @page.identifier, event: @event, view: (@view == WoodsMap::Lifecycle::VIEWS.first ? nil : @view)), mermaid: mermaid, key: 'y', label: panel[:label], refusal: (@lifecycle.refusal(@event, view: @view) && "#{@lifecycle.refusal(@event, view: @view)}; the steps below list every one."), legend: panel[:legend] + (steps.any?(&:changed) ? [[chip(:modified), (@view == 'sequence' ? 'moved since the selected generation: marked in the steps below (a sequence has no node classes)' : 'outlined: its method or declaration moved since the selected generation')]] : []), provenance: ['resolved chain', "gen #{@repository.generation_number}"] %>
    </section>
    <section class="sec" aria-labelledby="ladder">
      <header><h2 class="t2" id="ladder">Steps for <%= @event %> <%= count_tag("#{steps.size} steps, in the order Rails runs them") %><%= info_tip('Order is the resolved runtime chain, not file order. Side effects come from a regex analysis of the callback body; a proc callback is skipped.') %></h2></header>
      <%= render 'woods_map/units/ladder', steps: steps, owner: @page.identifier, label: "Steps for #{@event}", event: @event %>
    </section>
    <% @state_machines.each_with_index do |machine, index| %>
      <% heading = "sm#{index}" %>
      <section class="sec" aria-labelledby="<%= heading %>">
        <header><h2 class="t2" id="<%= heading %>">State machine transitions <%= count_tag("#{machine.events.size} #{'event'.pluralize(machine.events.size)}, #{machine.states.size} #{'state'.pluralize(machine.states.size)}") %></h2><%= unit_link(machine.identifier, 'state_machine') %></header>
        <% state_text = machine.mermaid %>
        <%= render 'woods_map/components/diagram', title: 'State', facts: [machine.identifier, machine.gem].compact, name: "#{machine.identifier} state", mermaid_url: woods_map.unit_lifecycle_mmd_path(type: 'state_machine', identifier: machine.identifier), mermaid: state_text, label: "State diagram of #{machine.identifier}: #{machine.states.size} states and the events that move between them", refusal: (machine.refusal && "#{machine.refusal}; the transitions below list every one."), legend: [['label', 'the event, its guard in brackets, then after / the callbacks the transition carries'], ['●', 'enters the initial state']], provenance: ['state_machine unit', "gen #{@repository.generation_number}"] %>
        <% if machine.structured? %>
          <%= render 'woods_map/components/table', label: "Transitions of #{machine.identifier}", min_width: '980px', columns: [{ label: 'event', width: '140px', cell_class: 'nw id' }, { label: 'from → to', width: '170px' }, { label: 'guard', width: '120px' }, { label: 'before', cell_class: 'inline-links' }, { label: 'around', cell_class: 'inline-links' }, { label: 'after', cell_class: 'inline-links' }],
                rows: machine.transitions.map { |t|
                  carried = machine.callbacks_for(t)
                  { cells: [t.event || empty_value(applicable: false), "#{t.from} → #{t.to}", t.guard || empty_value(applicable: false),
                            transition_callbacks_cell(carried['before'], @unit), transition_callbacks_cell(carried['around'], @unit),
                            transition_callbacks_cell(Array(carried['after']) + Array(carried['after_failure']), @unit)] }
                } %>
        <% else %>
          <%= render 'woods_map/components/table', label: "Transitions of #{machine.identifier}", min_width: '560px', columns: [{ label: 'event', width: '180px', cell_class: 'nw id' }, { label: 'from → to' }, { label: 'guard', width: '200px' }],
                rows: machine.transitions.map { |t| { cells: [t.event || empty_value(applicable: false), "#{t.from} → #{t.to}", t.guard || empty_value(applicable: false)] } } %>
        <% end %>
      </section>
      <% unplaced = machine.structured? ? machine.unplaced_callbacks : [] %>
      <% if unplaced.any? %>
        <section class="sec" aria-labelledby="<%= heading %>up">
          <header><h2 class="t2" id="<%= heading %>up">Callbacks not tied to a transition <%= count_tag(unplaced.size) %><%= info_tip('Their scope is not literal (Woods names the field and never evaluates it), or no published transition matches it, so no row can carry them.') %></h2></header>
          <%= render 'woods_map/components/table', label: "Callbacks of #{machine.identifier} not tied to a transition", min_width: '700px', columns: [{ label: 'kind', width: '160px', cell_class: 'nw' }, { label: 'scope, as declared', width: '260px' }, { label: 'callback', cell_class: 'inline-links' }],
                rows: unplaced.map { |c| { cells: [c.kind, [("on #{c.on.join(', ')}" if c.on.any?), ("from #{c.from.join(', ')}" if c.from.any?), ("to #{c.to.join(', ')}" if c.to.any?), ("#{c.unresolved.join(', ')} not literal" if c.unresolved.any?)].compact.join('; ').presence || 'any transition', transition_callback_entry(c, @unit)] } } %>
        </section>
      <% end %>
      <% if !machine.structured? && machine.callbacks.any? %>
        <section class="sec" aria-labelledby="<%= heading %>cb">
          <header><h2 class="t2" id="<%= heading %>cb">Transition callbacks <%= count_tag(machine.callbacks.size) %><%= info_tip('As the extractor recorded each line of the DSL. This generation predates structured transition callbacks (woods#796): re-extract to tie each one to its transitions with its side effects.') %></h2></header>
          <%= render 'woods_map/components/table', label: "Transition callbacks of #{machine.identifier}", min_width: '560px', columns: [{ label: 'callback, as declared', cell_class: 'id' }, { label: 'source', width: '200px' }],
                rows: machine.callbacks.map { |line| { cells: [line, layer_chip('state machine DSL')] } } %>
        </section>
      <% end %>
    <% end %>
    <%= render 'woods_map/shared/status', items: [@view, 'numbers match the steps', "gen #{@repository.generation_number}"], keys: [[%w[c u d], 'event'], [@lifecycle.views.include?('dynamic') ? %w[s f l k] : %w[s f l], 'view'], [%w[y], 'copy Mermaid'], [%w[/], 'search']] %>
  </div>
</div>
