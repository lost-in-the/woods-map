<%# The sheet behind ☰ (C3-Navigation): below 960 the primary nav first, then
    files, then this page's sections. The file tree is not in the page:
    the sheet fetches it from tree_url the first time it opens and marks
    current_path there. The sheet borrows the page's nav.rail while open.
    The header stays put while the rest scrolls. Locals: tree_url (String or
    nil), current_path (String or nil), nav (Array of [label, href, current?]). %>
<div class="sheet-overlay" hidden data-sheet-target="overlay" data-action="click->sheet#outside">
  <div class="sheet" role="dialog" aria-modal="true" aria-label="Files and sections">
    <div class="sh"><button class="tool" type="button" aria-label="Close" data-action="sheet#close" data-sheet-target="close">✕</button><span class="eyebrow">files</span><span class="eyebrow aside">on this page</span></div>
    <div class="sheet-scroll" data-sheet-target="scroll">
      <nav class="sheet-nav" aria-label="Primary, in the sheet"><ul><% Array(local_assigns[:nav]).each do |label, href, current| %><li><a href="<%= href %>"<%= ' aria-current="page"'.html_safe if current %>><%= label %></a></li><% end %></ul></nav>
      <div data-sheet-target="body">
        <% if local_assigns[:tree_url] %>
          <div class="sheet-tree" data-sheet-target="tree" data-src="<%= tree_url %>" data-current="<%= local_assigns[:current_path] %>"><p class="cap padx" role="status" data-sheet-target="treeStatus">The file tree loads when the sheet opens.</p></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
