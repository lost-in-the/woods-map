<%# The neighbourhood explorer shared by the Graph tab (B6-Graph) and the
    full-screen graph page (notes/graph-page.md): the filter rail, the
    Cytoscape canvas the graph controller draws, the Pele flowchart that is
    the page without JavaScript and the Mermaid export, and the list
    equivalent. Locals:
      identifier, type   the centre's typed identity
      n                  WoodsMap::Neighbourhood
      link               ->(**params) URL of this view with other params
      unit_url           URL template with __type__ and __identifier__
      rail_extra         HTML for the rail after the filters, or nil
      blast              WoodsMap::BlastRadius or nil (tints the canvas)
      page               true on the full-screen page
      mermaid_url        the flowchart's .mmd route (D-25), or nil
      hidden             Hash of extra GET fields the filter form keeps (the impact page's range)
      emphasis           :range when blast holds a range report's changed (distance 0)
                         and affected units (E-3, E-8); the radius of this unit otherwise
      flows              Hash from GraphFlow.entries, or nil (no flows group)
      flow               WoodsMap::GraphFlow the page's ?flow= selects, or nil (A-4)
      timeline           WoodsMap::GraphTimeline, or nil (A-6) %>
<% blast = local_assigns[:blast] %>
<% flows = local_assigns[:flows] %>
<% flow = local_assigns[:flow] %>
<% timeline = local_assigns[:timeline] %>
<% keep = { flow: flow&.entry_point } %>
<% range = local_assigns[:emphasis] == :range %>
<% blast_legend = range ? [['changed in this range', 0], ['affected directly', 1], ['affected transitively', 2]] : [['a change here reaches it directly', 1], ['transitively', 2]] %>
<% page = local_assigns.fetch(:page, false) %>
<% pick = guide_status == :ready %>
<% filters = { types: params[:types].presence, via: params[:via].presence } %>
<% flow_link = ->(**opts) { link.call(direction: n.direction, depth: n.depth, blast: (blast && !range ? '1' : nil), **filters, **opts) } %>
<% graph_label = "Neighbourhood of #{identifier} at depth #{n.depth}, #{n.direction}: units and their edges, each edge labelled with its mechanism. Arrow keys move along the edges, Enter opens a unit's graph; the list below has the same edges." %>
<% cache_key = [@repository.generation_number, type, identifier, n.depth, n.direction, Array(filters[:types]).sort.join(','), Array(filters[:via]).sort.join(',')].join('|') %>
<% blast_units = blast ? blast.affected.map { |a| { 'identifier' => a.identifier, 'type' => a.type, 'distance' => a.distance } } : nil %>
<div class="body<%= ' graph-page' if page %>" data-controller="trail graph" data-trail-title-value="<%= identifier %>"
     data-graph-url-value="<%= woods_map.neighbourhood_path(centre: identifier, type: type, depth: n.depth, direction: n.direction, **filters) %>"
     data-graph-unit-url-value="<%= unit_url %>"
     data-graph-generation-value="<%= @repository.generation_number %>"
     data-graph-cache-value="<%= cache_key %>"<% if pick %>
     data-graph-pick-value="true"<% end %><% if blast_units %>
     data-graph-blast-value="<%= blast_units.to_json %>"<% end %><% if range %>
     data-graph-emphasis-value="range"<% end %><% if flow&.found? %>
     data-graph-flow-value="<%= flow.payload.to_json %>"<% end %><% if timeline&.commits&.any? %>
     data-graph-timeline-value="<%= timeline.payload.to_json %>"<% end %>>
  <nav class="rail" aria-label="Graph filters">
    <form method="get" action="<%= link.call %>">
      <h2 class="t3 on">Neighbourhood</h2>
      <div class="grp">direction</div>
      <div class="pad1"><span class="seg" role="group" aria-label="Direction"><% %w[both dependents dependencies].each do |d| %><a href="<%= link.call(direction: d, depth: n.depth, **keep) %>"<%= ' aria-current="true"'.html_safe if n.direction == d %>><%= d %></a><% end %></span></div>
      <div class="grp">blast radius</div>
      <% if page %>
        <div class="pad1"><span class="seg" role="group" aria-label="Blast radius"><% [['off', nil], ['tint', '1']].each do |label, value| %><a href="<%= link.call(direction: n.direction, depth: n.depth, blast: value, **filters, **keep) %>"<%= ' aria-current="true"'.html_safe if blast.nil? == value.nil? %>><%= label %></a><% end %></span></div>
      <% end %>
      <ol><li><span class="k">·</span><span><a href="<%= woods_map.impact_path(focus: identifier, depth: 2) %>">what a change here reaches</a> <span class="own">impact, pre-change mode</span></span></li></ol>
      <div class="grp">depth</div>
      <div class="pad1"><span class="seg" role="group" aria-label="Depth"><% [1, 2].each do |d| %><a href="<%= link.call(direction: n.direction, depth: d, blast: (blast ? '1' : nil), **keep) %>"<%= ' aria-current="true"'.html_safe if n.depth == d %>><%= d %></a><% end %></span></div>
      <input type="hidden" name="direction" value="<%= n.direction %>"><input type="hidden" name="depth" value="<%= n.depth %>"><% if blast && !range %><input type="hidden" name="blast" value="1"><% end %>
      <% local_assigns.fetch(:hidden, {}).each do |name, value| %><input type="hidden" name="<%= name %>" value="<%= value %>"><% end %>
      <div class="grp">types <span class="cnt"><%= n.type_counts.size %></span></div>
      <% n.type_counts.each do |t, count| %><label class="f"><input type="checkbox" name="types[]" value="<%= t %>"<%= ' checked'.html_safe if params[:types].nil? || Array(params[:types]).include?(t) %>> <%= t.to_s.tr('_', ' ') %> <span class="cnt"><%= count %></span></label><% end %>
      <div class="grp">via <span class="cnt"><%= n.via_counts.values.sum(&:size) %></span></div>
      <% n.via_counts.each do |family, vias| %><div class="grp flush"><%= family %></div><% vias.each do |via, count| %><label class="f"><input type="checkbox" name="via[]" value="<%= via %>"<%= ' checked'.html_safe if params[:via].nil? || Array(params[:via]).include?(via) %>> <%= via %> <span class="cnt"><%= count %></span></label><% end %><% end %>
      <div class="pad3"><button class="btn" type="submit">apply filters</button></div>
      <div data-graph-target="positions" hidden>
        <div class="grp">positions</div>
        <p class="cap padx">Dependents left, dependencies right, this unit in the middle. Positions you drag are kept per generation in this browser. <button class="tool" type="button" data-action="graph#forget">reset positions</button></p>
      </div>
      <% if timeline&.author %><input type="hidden" name="author" value="<%= timeline.author %>"><% end %><% if flows %><% if params[:flow].present? %><input type="hidden" name="flow" value="<%= params[:flow] %>"><% end %><%= render 'woods_map/graphs/flows_rail', flows: flows, flow: flow, link: flow_link %><% end %>
      <%= local_assigns[:rail_extra] %>
    </form>
  </nav>
  <div class="main">
    <section class="sec">
      <div class="dia graph" data-graph-target="panel" hidden>
        <div class="dh"><b>Neighbourhood</b><span class="gfacts" data-graph-target="facts"></span><span class="tools">
          <button class="tool" type="button" aria-label="Zoom in" data-action="graph#zoomIn">+</button>
          <button class="tool" type="button" aria-label="Zoom out" data-action="graph#zoomOut">−</button>
          <button class="tool" type="button" data-action="graph#fit">fit</button>
          <%= render 'woods_map/components/mermaid_tools', text: n.mermaid, name: "#{identifier} neighbourhood depth #{n.depth}", url: local_assigns[:mermaid_url], refused: n.refusal.present? %>
          <button class="tool" type="button" aria-pressed="false" aria-controls="graph-flowchart" data-graph-target="flowchart" data-action="graph#flowchart">flowchart</button>
        </span></div>
        <div class="gcanvas" tabindex="0" role="application" aria-roledescription="graph" aria-label="<%= graph_label %>" aria-describedby="graph-status" data-graph-target="canvas"></div>
        <p class="gstatus" id="graph-status" role="status" data-graph-target="status">Tab to the canvas: arrow keys move along the edges, Enter opens a unit's graph, + and − zoom, 0 fits.<% if pick %> Space or Shift+click adds a unit to the guide's context.<% end %></p>
        <% legend = n.type_counts.keys.map { |t| [tag.i(class: 'sw gsw', data: { gtype: t }), t.to_s.tr('_', ' ')] } +
                    [[tag.span('──', class: 'ar'), 'association'], [tag.span('┄┄', class: 'ar'), 'other mechanisms'],
                     [tag.i(class: 'sw self'), 'this unit']] %>
        <% legend << [tag.i(class: 'sw gflow'), 'a step of the flow, the edge that reached it'] if flow&.found? %>
        <% legend << [tag.i(class: 'sw gtl'), 'changed in the timeline window'] if timeline&.commits&.any? %>
        <% if blast %><% legend += blast_legend.map { |text, distance| [tag.i(class: 'sw gblast', data: { distance: distance }), text] } %><% end %>
        <%= render 'woods_map/components/legend', entries: legend + [['', 'hub, cycle: graph_analysis, per identifier']],
                                                     provenance: ['typed edges', 'weight = pagerank', "gen #{@repository.generation_number}"] %>
      </div>
      <p class="cap refusal" role="status" data-graph-target="message" hidden></p>
      <div id="graph-flowchart" data-graph-target="fallback">
      <%= render 'woods_map/components/diagram', title: 'Neighbourhood', facts: ["#{identifier}, depth #{n.depth}, #{n.direction}", "#{n.node_count} #{'unit'.pluralize(n.node_count)}", "#{n.edges.size} #{'edge'.pluralize(n.edges.size)}"],
            name: "#{identifier} neighbourhood depth #{n.depth}", mermaid_url: local_assigns[:mermaid_url],
            mermaid: n.mermaid, label: "Neighbourhood of #{identifier} at depth #{n.depth}: #{n.edges.size} edges, each labelled with its mechanism; the list below has the same edges",
            refusal: (n.refusal && "#{n.refusal}. The list below has every edge."),
            legend: [[tag.i(class: 'sw self'), 'this unit'], [tag.span('→', class: 'ar'), 'edge, labelled with its mechanism']], provenance: ['typed edges', "gen #{@repository.generation_number}"] %>
      </div>
    </section>
    <% if flow %><%= render 'woods_map/graphs/flow', flow: flow, n: n %><% end %>
    <% if timeline %><%= render 'woods_map/graphs/timeline', timeline: timeline %><% end %>
    <% edge_list = WoodsMap::ListPage.new(n.edges, params[:page], per: WoodsMap::Neighbourhood::LIST_PER_PAGE) %>
    <section class="sec" id="edge-list" data-controller="rows" data-graph-target="list">
      <header><h2 class="t2">List equivalent <%= count_tag("#{n.edges.size} of #{n.all_edges.size} edges") %><%= info_tip('The same edges the canvas and the flowchart draw; dependents point at this unit, dependencies away from it. Notes come from graph_analysis.json, per identifier. Arrow keys move between rows; a row in focus lights its edge on the canvas.') %></h2></header>
      <% reached = blast ? blast.affected.to_h { |a| [[a.identifier, a.type], a.distance] } : {} %>
      <%= render 'woods_map/components/table', label: 'Edges', min_width: '720px', columns: [{ label: 'from', width: '30%' }, { label: 'via', width: '160px', cell_class: 'nw' }, { label: 'to', width: '30%', cell_class: 'id' }, { label: 'notes' }],
            rows: edge_list.items.map { |e|
              other = n.focus?(e.from, e.from_type) ? [e.to, e.to_type] : [e.from, e.from_type]
              notes = n.notes(other.first) + (e.depth > 1 ? ['2 hops'] : [])
              if reached[other]
                notes << if range then reached[other].zero? ? 'changed in this range' : "affected, #{reached[other]} #{'hop'.pluralize(reached[other])} from a change"
                         else reached[other] == 1 ? 'a change here reaches it directly' : "a change here reaches it in #{reached[other]} hops"
                         end
              end
              { data: { edge: WoodsMap::GraphElements.edge_id(e) },
                cells: [n.focus?(e.from, e.from_type) ? e.from : unit_link(e.from, e.from_type), e.via, n.focus?(e.to, e.to_type) ? e.to : unit_link(e.to, e.to_type), notes.join(', ').presence || empty_value(applicable: false)] }
            } %>
      <%= render 'woods_map/components/pager', list: edge_list, noun: 'edges', anchor: 'edge-list' %>
    </section>
    <%= render 'woods_map/shared/status', items: ['typed edges', 'graph_analysis', "gen #{@repository.generation_number}"], keys: [[%w[← ↑ → ↓], 'move'], [%w[↵], 'open'], [%w[1 2], 'depth'], [%w[/], 'search']] %>
  </div>
</div>
